def evaluate(objects, seals):
    missing = sorted(set(REQUIRED) - set(objects))
    checks, unresolved, bindings = {}, [], {}
    def available(*names):
        return all(name in objects for name in names)
    if available("ambient", "coverage", "coverage_review"):
        domain, historical, complement = coverage_partition(objects["ambient"], objects["coverage"], objects["coverage_review"])
        require(objects["coverage_review"]["coverage_sha256"] == seals["coverage"], "Reviewed coverage bytes")
        checks["368_partition"] = True
    else:
        domain, historical, complement = {}, {}, {}
    if available("two_chamber_review", "two_chamber_data"):
        record = objects["two_chamber_review"]
        require(record["status"] == "HUMAN_TWO_CHAMBER_IMPLICATION_ACCEPTED_CONDITIONAL_ON_BOTH_TARGET_OUTCOMES" and
                record["bridge_sha256"] == seals["two_chamber_data"] and record["required_second_target_nonhit_count"] == 365, "Two-chamber human implication")
        checks["human_two_chamber_implication"] = True
    if historical and available(*REVIEW_DEPENDENCIES['legacy_outcome_review']):
        bindings = legacy_conjunction_join(objects, seals, historical, objects['coverage'])
        checks['actual_legacy150_plus_recovery65'] = True
    if complement and available("v82_aggregate", "v82_package", "v82_manifest", "v82_supervisor_result", "v82_runtime"):
        v82_join(objects["v82_aggregate"], objects["v82_package"], seals, complement, objects["coverage"])
        checks["actual_v82_504"] = True
        for label in complement:
            bindings[label] = {"kind": "PAIRED_POINTWISE_V82", "v82_aggregate_sha256": seals["v82_aggregate"],
                               "full_result_sha256": {backend: objects["v82_aggregate"]["jobs"][label + "/" + backend]["result_sha256"] for backend in BACKENDS}}
    if historical and available("v83_audit", "v83_inventory", "v83_state", "v83_runtime"):
        unresolved = v83_join(objects["v83_audit"], objects["v83_inventory"], objects["v83_state"], seals, set(historical) | set(complement))
        checks["actual_v83_365_paired"] = True
    for name, dependencies in REVIEW_DEPENDENCIES.items():
        if available(name, *dependencies):
            final_review(name, objects[name], seals); checks[name] = True
    incomplete_positive = []
    if available("positive_control_audit"):
        incomplete_positive = positive_join(objects["positive_control_audit"])
        checks["actual_twelve_positive_controls"] = not incomplete_positive
    if available("representative_control_audit", "v83_audit"):
        representative_join(objects["representative_control_audit"], objects["v83_audit"], seals)
        checks["actual_same_plan_representative_controls"] = True
    if available("portable_adoption_record", "source_isomorphism_review", "v83_audit", "positive_control_audit", "representative_control_audit"):
        adoption_join(objects["portable_adoption_record"], objects["source_isomorphism_review"], objects["v83_audit"], seals)
        portable = objects["portable_adoption_record"]["portable_source_sha256"]
        require(objects["positive_control_audit"]["source_state"]["portable_math_sha256"] ==
                objects["representative_control_audit"]["portable_source_sha256"] == portable, "Both control cohorts use the adopted portable source")
        require(set(objects["source_isomorphism_review"]["approved_portable_runtime_sha256"]) ==
                {objects["positive_control_audit"]["approved_runtime_sha256"], objects["representative_control_audit"]["approved_runtime_sha256"]},
                "Actual positive/representative runtime profiles covered by final source-semantics review")
        checks["actual_portable_evidence_adoption"] = True
    rows = [{"point_label": label, "first_target_family": "LEGACY116" if label in historical else "V82_249",
             "first_target_binding": bindings.get(label, {"status": "UNBOUND"}),
             "reflected_status": (objects["v83_audit"]["points"][label]["outcome"] if checks.get("actual_v83_365_paired") else "NOT_AUDITED"),
             "reflected_full_result_sha256": ({backend: objects["v83_audit"]["points"][label]["accepted"]["full"][backend]["result_sha256"] for backend in BACKENDS}
                                               if checks.get("actual_v83_365_paired") else None),
             "new_curve_hit_claimed": False} for label in sorted(set(historical) | set(complement))]
    ready = not missing and not unresolved and not incomplete_positive
    return {"schema_version": 1, "status": ("CONDITIONAL_EVIDENCE_JOIN_READY_FOR_FINAL_THEOREM_REVIEW" if ready
            else "CONDITIONAL_JOIN_BLOCKED_MISSING_EVIDENCE_OR_UNRESOLVED_OUTCOME"),
            "scope": "FIXED_MARKED_NORM_PI_C39_PACKET_NORMALIZED_TRACE_POLARIZED_SL2_QUOTIENT",
            "checks_passed": checks, "missing_evidence": missing, "incomplete_positive_controls": incomplete_positive,
            "survivor_labels_unresolved": unresolved, "known_positive_labels": HITS,
            "nonhit_rows": rows, "nonhit_count": len(rows), "ambient_count": len(domain),
            "reference_counts": {"historical_labels": len(historical), "v82_labels": len(complement),
                                 "distinct_legacy_geometry_commands": 128 if historical else None,
                                 "v82_full_jobs": 504 if checks.get("actual_v82_504") else None,
                                 "v83_accepted_prep_and_full_backend_records": 1460 if checks.get("actual_v83_365_paired") else None,
                                 "v83_adopted_full_jobs": 730 if checks.get("actual_portable_evidence_adoption") else None},
            "collective_r83_pic1_is_not_individual_mask_permutation": True,
            "certified_coverage_changed": False, "C44_complete": False, "theorem_promotion": False,
            "registration_applied": False, "full_release": False,
            "input_sha256": seals,
            "limits": ["Hashes identify supplied evidence, not independent approval authority.",
                       "Source/design gates never replace actual outcome and archival review.",
                       "Necessary-polygon survivors remain unresolved and are not new curve points.",
                       "First-target collective Pic1 coverage transfers a universal statement, not per-mask digests."]}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--evidence-root", type=Path, required=True)
    parser.add_argument("--manifest", type=Path, required=True)
    parser.add_argument("--manifest-sha256", required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    own_hash = sha(Path(__file__))
    require(__debug__ and not args.output.exists(), "Assertions enabled and fresh output required")
    require(sha(args.manifest) == args.manifest_sha256, "External input manifest binding")
    manifest = decode(args.manifest.read_bytes())
    require(type(manifest["schema_version"]) is int and manifest["schema_version"] == 1 and
            manifest["status"] == "CONDITIONAL_JOIN_INPUTS_NO_PROMOTION", "Join manifest schema")
    require(set(manifest["references"]) == set(REQUIRED), "Exact named gate inventory")
    evidence = Evidence(args.evidence_root, manifest["references"])
    for name, checksum in STATIC_PINS.items():
        if name in evidence.hashes:
            require(evidence.hashes[name] == checksum, "Unreviewed static anchor: " + name)
    report = evaluate(evidence.objects, evidence.hashes)
    evidence.recheck()
    require(sha(args.manifest) == args.manifest_sha256, "Input manifest changed")
    require(sha(Path(__file__)) == own_hash, "Join source changed")
    report.update(join_source_sha256=own_hash, input_manifest_sha256=args.manifest_sha256)
    with args.output.open("xb") as stream:
        stream.write(canonical(report))
    print(json.dumps({"status": report["status"], "missing_evidence": report["missing_evidence"],
                      "survivor_labels_unresolved": report["survivor_labels_unresolved"],
                      "output_sha256": sha(args.output)}, sort_keys=True))


if __name__ == "__main__":
    main()
