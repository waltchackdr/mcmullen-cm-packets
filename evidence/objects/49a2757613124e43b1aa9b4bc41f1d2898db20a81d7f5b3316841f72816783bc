"""Read-only interpretation of a completed session; no mathematical adoption."""
import argparse
import hashlib
import json
from pathlib import Path
import resource
import signal

ROOT = Path(__file__).resolve().parents[2]


def checked(path, pin=None, size=None):
    path = Path(path)
    assert path.is_file() and not path.is_symlink()
    assert path.stat().st_size <= 32*1024**2
    raw = path.read_bytes()
    assert pin is None or hashlib.sha256(raw).hexdigest() == pin
    assert size is None or len(raw) == size
    return raw


def read_json(path, pin=None):
    return json.loads(checked(path,pin))


def inspect(authority, expected, controller, output):
    approval = read_json(authority,expected)
    assert approval['status'] == 'INDEPENDENTLY_ACCEPTED_V150_SESSION'
    for path,pin in approval['pins'].items():
        checked(ROOT/path,pin)
    outcome = read_json(controller/'outcome.json')
    cleanup = read_json(controller/'cleanup.json')
    assert outcome['status'] == 'SESSION_QUEUE_ENDED' and len(outcome['jobs']) == 2
    assert cleanup['provider_absence_verified'] is True
    catalog = read_json(ROOT/'experiments/s_order_models_v161/catalog_candidate.json')
    records, provenance, runtimes = [], [], []
    output.mkdir(parents=True,exist_ok=False)
    for job,packet_ref in enumerate(approval['jobs']):
        packet = read_json(ROOT/packet_ref['path'],packet_ref['sha256'])
        source = read_json(ROOT/packet['uploads']['source_manifest']['path'],packet['uploads']['source_manifest']['sha256'])
        job_manifest = read_json(ROOT/packet['code']['job_manifest.json']['path'],packet['code']['job_manifest.json']['sha256'])
        root = controller/f'jobs/job{job}/controller'
        job_outcome = read_json(root/'outcome.json')
        assert job_outcome == outcome['jobs'][job]
        assert job_outcome['remote_stage'] == 'PIPELINE_ENDED' and job_outcome['returncode'] == 0
        ref = job_outcome['retention']
        receipt_path = Path(ref['receipt']).resolve()
        assert receipt_path.is_relative_to(root.resolve()/'retained')
        receipt = read_json(receipt_path,ref['sha256'])
        assert not receipt['rejected'] and set(receipt['missing']) <= {'guard_delete.json'}
        blobs = {}
        for name,item in receipt['artifacts'].items():
            blobs[name] = checked(root/'retained/blobs'/(item['sha256']+'.blob'),item['sha256'],item['bytes'])
        started = json.loads(blobs['benchmark/started.json'])
        summary = json.loads(blobs['benchmark/summary.json'])
        pipeline = json.loads(blobs['pipeline.json'])
        assert started['plan_sha256'] == summary['plan_sha256'] == source['plan_sha256'] == job_manifest['transport']['plan_sha256']
        assert started['worker_sha256'] == source['files']['experiments/bc_jacobian_v147/certificate_worker_candidate.py']['sha256']
        assert summary['status'] == 'EXACT_MODEL_CENSUS_REVIEW_REQUIRED' and summary['complete_model_count'] == 80
        assert pipeline['benchmark_returncode'] == pipeline['setup_returncode'] == 0
        assert pipeline['status'] == 'ATTEMPT_ENDED_NO_THEOREM'
        runtime = blobs['setup/runtime.json']
        complete = json.loads(blobs['setup/setup_complete.json'])
        assert hashlib.sha256(runtime).hexdigest() == complete['runtime_sha256'] == pipeline['runtime_sha256']
        runtimes.append({'job':job,'sha256':hashlib.sha256(runtime).hexdigest(),'runtime':json.loads(runtime)})
        for task in range(8):
            result = json.loads(blobs[f'benchmark/task{task:02d}/result.json'])
            assert result == summary['results'][task]
            assert result['status'] == 'EXITED' and result['returncode'] == 0
            start = 80*job+10*task
            assert result['task']['start'] == start and result['task']['count'] == 10
            raw = blobs[f'benchmark/task{task:02d}/stdout.jsonl']
            lines = raw.splitlines(); assert len(lines) == 10
            for offset,line in enumerate(lines):
                model = json.loads(line); index = start+offset
                assert model['catalog_index'] == index
                assert model['status'] == 'EXACT_MODEL_CANDIDATE_NOT_THETA_EVALUATION'
                assert model['theta_evaluations'] == 0 and model['fiber_levels'] == [261,234,234]
                assert model['actual_tangent_type'] == [1,5,11,13,17,19]
                assert model['endomorphism_order'] == catalog['models'][index]['endomorphism_order']
                assert model['lagrangian_rows'] == catalog['models'][index]['lagrangian_rows']
                for name,pin in model['input_pins'].items():
                    assert source['files'][name]['sha256'] == pin
                expected_input_names = {'experiments/s_order_models_v161/'+name for name in ['model_candidate.py','model.json','catalog_candidate.json']}
                expected_input_names |= {'certificates/'+name for name in ['principal_unmarked_bc_data.json','principal_bc_unpolarized_data.json','actual_bc_polarizations_data.json']}
                assert set(model['input_pins']) == expected_input_names
                path = output/f'model{index:03d}.json'
                path.write_bytes(line+b'\n')
                records.append(index)
                provenance.append({'index':index,'path':str(path),'sha256':hashlib.sha256(line+b'\n').hexdigest(),
                                   'job':job,'task':task,'stdout_sha256':hashlib.sha256(raw).hexdigest(),'line':offset+1})
    assert records == list(range(160))
    result = {'status':'RETAINED160_EXACT_MODEL_CANDIDATES_NOT_ADOPTED','authority_sha256':expected,
              'models':provenance,'R_count':4,'S_count':156,'runtime_observations':runtimes,
              'provider_absence_verified':True,'mathematical_adoption':False,
              'scope':'Raw byte/source/plan/task completeness and asserted metadata only. Independent exact matrix and coordinate audit remains required; no theta/Jacobian conclusion.'}
    (output/'inspection.json').write_text(json.dumps(result,indent=2)+'\n')
    return {'status':result['status'],'models':len(records),'R':4,'S':156,'output':str(output)}


if __name__ == '__main__':
    resource.setrlimit(resource.RLIMIT_CPU,(20,20)); signal.alarm(30)
    p=argparse.ArgumentParser()
    p.add_argument('--authority',type=Path,required=True);p.add_argument('--authority-sha256',required=True)
    p.add_argument('--controller',type=Path,required=True);p.add_argument('--output',type=Path,required=True)
    a=p.parse_args()
    print(json.dumps(inspect(a.authority,a.authority_sha256,a.controller,a.output)))
