class BodyTests(unittest.TestCase):
    def handler(self, lengths, raw=b'abc', transfer=None):
        headers=email.message.Message()
        for value in lengths:headers['Content-Length']=value
        if transfer is not None:headers['Transfer-Encoding']=transfer
        return types.SimpleNamespace(headers=headers,rfile=io.BytesIO(raw),
            connection=types.SimpleNamespace(settimeout=lambda seconds:None))

    def test_exact_body(self):
        self.assertEqual(server.read_body(self.handler(['3']),3,time.monotonic()+2),b'abc')

    def test_ambiguous_lengths(self):
        for values in ([],['3','3'],['-1'],['three']):
            with self.subTest(values=values),self.assertRaises(ValueError):
                server.read_body(self.handler(values),3,time.monotonic()+2)

    def test_all_transfer_encoding_rejected(self):
        for value in ('chunked',''):
            with self.subTest(value=value),self.assertRaises(ValueError):
                server.read_body(self.handler(['3'],transfer=value),3,time.monotonic()+2)

    def test_truncated_and_oversized(self):
        for length,maximum in (('4',4),('4',3)):
            with self.subTest(length=length,maximum=maximum),self.assertRaises(ValueError):
                server.read_body(self.handler([length]),maximum,time.monotonic()+2)

    def test_expired_body_deadline(self):
        with self.assertRaises(TimeoutError):
            server.read_body(self.handler(['3']),3,time.monotonic()-1)

    def test_delayed_bootstrap_arms_deletion_before_refusing_compute(self):
        for remote_offset in (100,-1):
            with self.subTest(remote_offset=remote_offset),tempfile.TemporaryDirectory() as tmp:
                base=Path(tmp);(base/'job_manifest.json').write_text('{}')
                env={'RUNPOD_POD_ID':'fake-pod','RESEARCH_GUARD_KEY':'fake',
                     'RESEARCH_DEADLINE':str(time.time()+remote_offset),
                     'RESEARCH_LOCAL_DELETE':str(time.time()-10)}
                with patch.object(server,'BASE',base),patch.object(server.sys,'platform','linux'),\
                     patch.dict(server.os.environ,env),\
                     patch.object(server.subprocess,'Popen') as spawn,\
                     patch.object(server,'Job') as job:
                    with self.assertRaises(ValueError):server.serve()
                    spawn.assert_called_once()
                    self.assertIn('--guard',spawn.call_args.args[0])
                    self.assertTrue(spawn.call_args.kwargs['start_new_session'])
                    job.assert_not_called()


