"""Independent cyclic section check; actual descent/obstruction is human proof."""
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
ROOT=Path(__file__).resolve().parents[1]
class DefinitionField(unittest.TestCase):
    def test_root_section_and_scalar_obstruction(self):
        source=ROOT/'experiments/all_underlying_galois_v165/referee_definition_field01.py'
        with tempfile.TemporaryDirectory() as folder:
            target=Path(folder)/source.name;target.write_bytes(source.read_bytes())
            result=subprocess.run([sys.executable,str(target)],check=True,capture_output=True,text=True,timeout=20)
        d=json.loads(result.stdout)
        self.assertEqual(d['status'],'PASS')
        self.assertEqual(d['section_product_cases'],196)
        self.assertEqual(d['root_reduction_kernel_order'],3)
        self.assertTrue(d['naive_nonhomomorphic_lift_rejected'])
        self.assertEqual(d['outside_U14_scalar_orders'],[4,28])
        self.assertEqual(d['minimal_field_degrees_over_F3'],{'4':2,'28':6})
        self.assertTrue(d['three_space_invariance_impossible'])
        self.assertEqual(d['twisted_torsion_exponent_zero_cases'],14)
if __name__=='__main__':unittest.main()
