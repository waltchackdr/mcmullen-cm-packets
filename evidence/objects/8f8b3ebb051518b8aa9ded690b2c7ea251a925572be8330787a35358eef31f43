           snapshot['manifest_sha256']==state['source_manifest_sha256']==h['legacy_source_manifest'] and
           state['snapshot_sha256']==h['legacy_snapshot'],'Committed source snapshot')
    registered=manifest['registered_commands'];rows=state['rows'];records=report['records']
    C.need(rows==state['registered_command_vectors'] and len(rows)==len(registered)==159 and
           [r['index'] for r in rows]==[r['index'] for r in registered]==list(range(1,160)), 'Exact159 original vectors')
