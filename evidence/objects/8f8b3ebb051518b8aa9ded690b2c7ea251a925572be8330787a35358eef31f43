           review['actual_report_independently_reproduced'] is True and review['report_sha256']==h['legacy_audit'] and
           review['policy_sha256']==h['legacy_conjunction_policy'],'Actual hardened150 evidence')
    C.need(state['status']=='MATH_PHASE_FAILED_OR_INCOMPLETE' and report['old_pool_end_guard_status']=='NOT_EXECUTED_AFTER_FAILURE'
           and all(report[k] is False for k in ('original159_pass','old_source_unchanged_proved','old_runtime_unchanged_proved')),
