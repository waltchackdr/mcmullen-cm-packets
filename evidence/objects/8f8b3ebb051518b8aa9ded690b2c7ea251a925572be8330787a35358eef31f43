def evaluate(o,h,recover,old_join):
    # Validate known evidence even when later gates are missing.
    bindings=old150(o,h) if all(k in o for k in ('legacy_audit','legacy_state','legacy_source_manifest','legacy_snapshot',
                                                'legacy_150_review','legacy_eight_review','legacy_conjunction_policy')) else None
    plans=None;retained=None;prior=None
    if 'legacy_source_manifest' in o and 'recovery_approval' in o:
        a=o['recovery_approval'];plans=recover.plan(o['legacy_source_manifest']['registered_commands'],Path(a['source']),a['python_invocation'])
        if all(k in o for k in ('recovery63_review','recovery_progress','recovery_initial_state','recovery_runtime')):
            retained,prior=recovery63(o,h,plans)
    labels=o['portable_plan']['efficiency']['proposed_full_negative_control_labels'] if 'portable_plan' in o else []
    C.need(not labels or len(labels)==len(set(labels))==16,'Fixed16 representative inventory')
    missing=sorted(set(REQUIRED)-set(o))
    base={'schema_version':1,'original159_pass':False,'old65_pass':False,'old_endguards_reconstructed':False,
          'theorem_promotion':False,'full_release':False,'current_tmp_raw_retention_complete':False,
          'fixed_representative_required_jobs':32,'fixed_representative_labels':labels,
          'representative_policy_reduced_or_satisfied_by_legacy':False,'input_sha256':h}
    if missing:
        return {**base,'status':'LEGACY_150_63_2_CONJUNCTION_BLOCKED','missing_gates':missing,
                'verified_retained_original_commands':0 if bindings is None else len(bindings),
                'verified_old_recovery_completions':0 if retained is None else len(retained)}
    partition=o['partition_review']
    C.need(partition['status']=='PASS_CONDITIONAL_LEGACY_WHOLE_MASK_PARTITION_PROOF' and partition['replacement_jobs']==65,
           'Exact same-mask decomposition human proof')
    fresh=v87(o,h,prior,{r['key']:r for r in plans})
    combined={**retained,**fresh};C.need(len(combined)==65 and not set(retained)&set(fresh),'63+2 disjoint cover')
    for key,row in combined.items():
        binding=bindings.setdefault(row['original_index'],{'kind':'CROSSCOHORT_WHOLE_SINGLETON_CONJUNCTION','jobs':[]})
        binding['jobs'].append({'cohort':'V87_FRESH_TWO' if key in fresh else 'V84_RETAINED63','row':row})
    C.need(set(bindings)==set(range(1,160)) and all(len(bindings[i]['jobs'])==(1 if i==118 else 8) for i in FAILED),
           'Every original registered obligation restored exactly')
    policy=o['conjunction_policy_amendment']
    policy_deps=('legacy_audit','legacy_150_review','legacy_conjunction_policy','legacy_eight_review','legacy_runtime',
                 'recovery63_review','recovery_initial_state','recovery_progress','recovery_runtime',
                 'partition_review','legacy_source_manifest','legacy_snapshot')
    C.need(policy['status']=='ACCEPTED_CONDITIONAL_150_63_2_EXECUTION_EVIDENCE_POLICY' and
           policy['binds']=={k:h[k] for k in policy_deps} and policy['old150_immutable_source_runtime_assumption_accepted'] is True and
           policy['old63_immutable_source_runtime_assumption_accepted'] is True and policy['old_endguards_reconstructed'] is False and
           policy['prior_raw_current_execution_distinguished'] is True and policy['theorem_promotion'] is False,
           'Explicit revised historical operational assumption policy')
    _,historical,_=old_join.coverage_partition(o['ambient'],o['coverage'],o['coverage_review'])
    mapping={}
    for label,row in historical.items():
        mapping[label]={'kind':'COLLECTIVE32' if row['transfer']=='R83_PIC1_COLLECTIVE_POPULATION' else 'POINTWISE',
                        'legacy_command_indices':[c['index'] for c in row['commands']],
                        'command_evidence':{str(c['index']):bindings[c['index']] for c in row['commands']}}
    # The separate hostile review binds every actual input except itself. It
    # authorizes this conjunction's evidence, not registration or a theorem.
    review=o['legacy_outcome_review']
    C.need(review['status']=='PASS_REVIEWED_150_63_2_EQUIVALENT_COVER_NOT_ORIGINAL_SUITE_PASS' and
           review['binds']=={k:v for k,v in h.items() if k!='legacy_outcome_review'} and
           review['actual_execution_source_runtime_and_retention_reviewed'] is True and
           review['original159_pass'] is False and review['old65_pass'] is False and review['theorem_promotion'] is False,
           'Final actual conjunction outcome review required')
    return {**base,'status':'REVIEWED_LEGACY_150_PLUS_63_PLUS_2_EQUIVALENT_COVER_NOT_PROMOTION',
            'missing_gates':[],'original_registered_obligations':159,'completed_executions':215,
            'original150':150,'retained_recovery63':63,'fresh_whole_jobs':2,'command_bindings':bindings,
            'first_target_historical_116':mapping,'failed_history':{
                'original_nine':[r for r in o['legacy_state']['rows'] if r['index'] in FAILED],
                'old_recovery_two':[prior[k] for k in NEW_KEYS]},
            'whole_packet_final_join_still_required':True}


def main():
    p=argparse.ArgumentParser(description=__doc__)
    for name in ('root','inputs','recover-source','old-join-source','output'):p.add_argument('--'+name,type=Path,required=True)
    a=p.parse_args();config=C.read(a.inputs);C.need(type(config['schema_version']) is int and config['schema_version']==1,'Input schema')
    before={p:C.sha(p) for p in (a.inputs,Path(__file__),HERE/'common.py',a.recover_source,a.old_join_source)}
    e=C.Evidence(a.root,config['references'],PINS)
    recover=C.load(a.recover_source,RECOVER_SHA,'frozen_legacy_partition_only')
    previous=C.load(a.old_join_source,OLD_JOIN_SHA,'frozen_first_target_population_only')
    result=evaluate(e.objects,e.seals,recover,previous)
    result['auditor_sha256']=before[Path(__file__)];result['common_sha256']=before[HERE/'common.py']
    e.recheck();C.need(all(C.sha(p)==h for p,h in before.items()),'Join source/input changed')
    C.write_new(a.output,result,[*e.paths.values(),*before]);print(result['status'])


if __name__=='__main__':main()
