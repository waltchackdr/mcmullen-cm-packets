               item['log_sha256']==actual['log_sha256'] and item['driver']==expected['command'][1] and
               item['driver_sha256']==manifest['files'][item['driver']]['sha256'] and
               C.valid_hash(item['intent_sha256']) and C.valid_hash(item['lease_sha256']),'Retained original complete execution')
