"""Retained finite ramification arithmetic; geometric inputs remain human proof."""
import json
import subprocess
import sys
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
BASE = ROOT / 'experiments/simple_cm_unmarked_v145'


class JacobianArithmeticTest(unittest.TestCase):
    def test_replay_ramification_and_type_identification(self):
        proc = subprocess.run([sys.executable, str(BASE / 'jacobian_check.py')],
                              capture_output=True, text=True, check=True, timeout=20)
        self.assertEqual(json.loads(proc.stdout), json.loads((BASE / 'jacobian_check.json').read_text()))


if __name__ == '__main__':
    unittest.main()
