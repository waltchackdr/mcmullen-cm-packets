#!/usr/bin/env python3
"""Read and compare the complete two-path pilot; never run geometry or promote."""
from collections import Counter
from fractions import Fraction
from hashlib import sha256
from pathlib import Path
import argparse
import json

ROOT = Path(__file__).resolve().parents[2]
POINTS = ("R127:pic0:00", "R43_20:pic0:00", "R7sq:pic0:00", "R41_22:pic0:00", "R43_31:pic0:00", "R7:pic0:00", "R127:pic1:00")
BACKENDS = ("primary", "sturm")
COMPLETE_STATUS = {
    "primary": "exact_discovery_complete_pending_independent_review",
    "sturm": "DISCOVERY_FULL_ENUMERATION_COMPLETE_PENDING_REVIEW",
}
ARTIFACTS = ("preparation.json", "A-entries.json", "C-entries.json",
             "bottom-rows.json", "candidates-nonzero.json", "candidates-zero.json",
             "classification.json", "survivors.json")


def require(condition, reason):
    if not condition:
        raise ValueError(reason)


def digest(path):
    return sha256(path.read_bytes()).hexdigest()


def read(path):
    return json.loads(path.read_text())


def vector(value):
    require(isinstance(value, list) and len(value) == 6, "Six coefficients required")
    require(all(isinstance(q, str) for q in value), "Rational strings required")
    result = tuple(Fraction(q) for q in value)
    require(all(q.denominator == 1 for q in result), "Nonintegral search entry")
    return tuple(int(q) for q in result)


def matrix(value):
    require(isinstance(value, list) and len(value) == 4, "Four matrix entries required")
    return tuple(vector(entry) for entry in value)


def unique_sorted(values, name):
    require(values == sorted(set(values)), f"Unsorted or duplicate {name}")
    return set(values)


def validate_artifacts(data, result, point):
    require(result["point_label"] == data["preparation.json"]["point_label"] == point,
            "Wrong point")
    counts = {}
    for name, key in (("A", "a_count"), ("C", "c_count")):
        values = [vector(v) for v in data[f"{name}-entries.json"]]
        unique_sorted(values, name)
        require(len(values) == result[key], f"{name} count differs")
        counts[key] = len(values)
    bottom = [tuple(vector(v) for v in row) for row in data["bottom-rows.json"]]
    require(all(len(row) == 2 for row in bottom), "Malformed bottom row")
    bottom_set = unique_sorted(bottom, "bottom rows")
    require(len(bottom) == result["bottom_rows"], "Bottom count differs")
    branches = {}
    for name, key in (("nonzero", "nonzero_candidates"), ("zero", "zero_candidates")):
        values = [matrix(v) for v in data[f"candidates-{name}.json"]]
        branches[name] = unique_sorted(values, name)
        require(all((v[2] == (0,)*6) == (name == "zero") for v in values), "Wrong c branch")
        require(len(values) == result[key], f"{name} count differs")
        counts[key] = len(values)
    require(branches["nonzero"].isdisjoint(branches["zero"]), "Overlapping determinant branches")
    candidates = branches["nonzero"] | branches["zero"]
    require(all((v[2], v[3]) in bottom_set for v in candidates), "Candidate has missing bottom row")
    survivors = [matrix(v) for v in data["survivors.json"]]
    survivor_set = unique_sorted(survivors, "survivors")
    require(len(survivors) == result["survivor_count"], "Survivor count differs")
    classification = data["classification.json"]
    require(classification["survivors"] == data["survivors.json"], "Survivor artifacts differ")
    excluded = []
    for row in classification["excluded"]:
        failure = tuple(row["failure"])
        require(len(failure) == 2 and type(failure[0]) is int and type(failure[1]) is int
                and 0 <= failure[0] < 4 and 0 <= failure[1] < 6, "Bad polygon failure")
        excluded.append((matrix(row["gamma"]), failure))
    excluded_matrices = [v for v, _ in excluded]
    excluded_set = unique_sorted(excluded_matrices, "excluded matrices")
    require(excluded_set.isdisjoint(survivor_set) and excluded_set | survivor_set == candidates,
            "Classification is not a disjoint exhaustive candidate partition")
    histogram = Counter(failure for _, failure in excluded)
    expected_histogram = [{"side_index": side, "embedding_index": embedding, "count": count}
                          for (side, embedding), count in sorted(histogram.items())]
    require(classification["histogram"] == expected_histogram, "Histogram differs")
    h = sha256()
    for value, failure in excluded:
        h.update((",".join(str(q) for entry in value for q in entry)
                  + f";{failure[0]},{failure[1]}\n").encode("ascii"))
    require(h.hexdigest() == result["classification_digest"], "Classification digest differs")
    audit = result["c_zero_audit"]
    require(len(audit) == 5 and all(type(n) is int and n >= 0 for n in audit), "Bad c=0 audit")
    require(audit[0] == sum(c == (0,)*6 for c, _ in bottom)
            and audit[1] == sum(c == d == (0,)*6 for c, d in bottom)
            and audit[1] == 1 and audit[0]-audit[1] >= audit[2] >= audit[3]
            and audit[4] == counts["zero_candidates"], "Inconsistent c=0 audit")
    return dict(**counts, bottom_rows=len(bottom), candidate_count=len(candidates),
                c_zero_audit=audit, classification_digest=h.hexdigest(),
                histogram=expected_histogram, survivor_count=len(survivors),
                survivors=data["survivors.json"])


def compare(run):
    runtime = read(run / "runtime.json")
    point = runtime["point_label"]
    require(point in POINTS, "Point outside reviewed pilot domain")
    require(runtime["status"] == "completed_pending_comparison_and_review"
            and runtime["mode"] == "full" and runtime["point_label"] == point,
            "Run is not a completed full discovery")
    require(runtime["changed_sources"] == [] and runtime["runtime_unchanged"] is True,
            "Source/runtime guard failed")
    require(set(runtime["results"]) == set(BACKENDS), "Wrong backend domain")
    for path, expected in runtime["source_sha256"].items():
        require(digest(run / "source" / path) == digest(ROOT / path) == expected,
                f"Source binding differs: {path}")
    for path, expected in runtime["artifact_sha256"].items():
        resolved = (run / path).resolve()
        require(resolved.is_relative_to(run.resolve()) and digest(resolved) == expected,
                f"Changed artifact: {path}")
    loaded, summaries = {}, {}
    for backend in BACKENDS:
        job = runtime["results"][backend]
        require(job["returncode"] == 0 and job["status"] == "completed_discovery_only", "Failed child")
        require(digest(run / backend / "child.log") == job["log_sha256"], "Changed log")
        directory = run / backend / "artifacts"
        result = read(directory / "result.json")
        require(result["status"] == COMPLETE_STATUS[backend]
                and result["sources_unchanged"] is True, "Incomplete adapter result")
        driver = f"experiments/broader_geometry_v71/{backend}.py"
        require(result["driver_sha256"] == runtime["source_sha256"][driver], "Driver differs")
        require(job["command"] == [runtime["runtime"]["python_executable"], "-B", "-u",
                str(run / "source" / driver), "--output", str(directory), "--point", point], "Wrong child command")
        require(set(ARTIFACTS) <= set(result["artifact_sha256"]), "Missing required artifacts")
        for name, expected in result["artifact_sha256"].items():
            require(Path(name).name == name and digest(directory / name) == expected, "Adapter artifact differs")
        loaded[backend] = {name: read(directory / name) for name in ARTIFACTS}
        summaries[backend] = validate_artifacts(loaded[backend], result, point)
    require(loaded["primary"] == loaded["sturm"], "Full mathematical artifacts differ across paths")
    for name in ARTIFACTS:
        require(digest(run / "primary" / "artifacts" / name)
                == digest(run / "sturm" / "artifacts" / name),
                f"Canonical artifact bytes differ: {name}")
    require(summaries["primary"] == summaries["sturm"], "Summary/audit differs across paths")
    summary = summaries["primary"]
    return dict(status=("MATCHED_DISCOVERY_SURVIVORS_REQUIRE_GEOMETRY" if summary["survivor_count"]
                        else "MATCHED_DISCOVERY_EMPTY_NECESSARY_SURVIVOR_SET"),
                point_label=point, scope="One-point discovery only; 112/368 certified remains unchanged",
                **summary, runtime_sha256=digest(run / "runtime.json"),
                comparator_sha256=digest(Path(__file__)))


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--run", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    result = compare(args.run.resolve())
    with args.output.open("x") as stream:
        stream.write(json.dumps(result, sort_keys=True, indent=2) + "\n")
    print(json.dumps({k: v for k, v in result.items() if k not in ("survivors", "histogram")}))


if __name__ == "__main__":
    main()
