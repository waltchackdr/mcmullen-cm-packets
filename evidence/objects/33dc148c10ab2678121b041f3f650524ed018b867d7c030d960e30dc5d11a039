 t=time.monotonic()
 # Model mu42 with reduction exponent mod14; mu14 is multiples of3.
 # 15=3*(3^-1 mod14) gives the unique prime-to3 subgroup lift.
 lift=lambda a:15*a%42
 assert {lift(a) for a in range(14)}=={3*a%42 for a in range(14)}
