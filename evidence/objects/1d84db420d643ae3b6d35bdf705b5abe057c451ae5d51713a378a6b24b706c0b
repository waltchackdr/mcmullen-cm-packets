"""Bounded replay of one model, plus rejection of invalid finite-field input."""
import importlib.util
import json
from pathlib import Path
import unittest

ROOT = Path(__file__).resolve().parents[1]
SPEC = importlib.util.spec_from_file_location('model161', ROOT/'experiments/s_order_models_v161/model_candidate.py')
MODEL = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(MODEL)


class ExactModelRegression(unittest.TestCase):
    def test_retained_exact_model(self):
        expected = json.loads((ROOT/'experiments/s_order_models_v161/model.json').read_text())
        actual = MODEL.run()
        expected.pop('runtime'); actual.pop('runtime')
        self.assertEqual(actual, expected)

    def test_nonintegral_finite_reduction_rejected(self):
        with self.assertRaises(AssertionError):
            MODEL.mod(MODEL.s.Matrix([[MODEL.s.Rational(1, 3)]]))


if __name__ == '__main__':
    import resource, signal
    resource.setrlimit(resource.RLIMIT_CPU, (20, 20)); signal.alarm(30)
    unittest.main()
