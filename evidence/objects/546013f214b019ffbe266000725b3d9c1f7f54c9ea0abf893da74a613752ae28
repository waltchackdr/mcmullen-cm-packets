"""Finite torsion dimensions; geometric interpretation is the reviewed human proof."""
import json
from pathlib import Path
import subprocess
import sys
import unittest

BASE = Path(__file__).resolve().parents[1] / 'experiments/bc_jacobian_v147'


class TorsionThetaTest(unittest.TestCase):
    def test_exact_orbit_histogram(self):
        result = subprocess.run([sys.executable, str(BASE / 'torsion_histogram.py')],
                                capture_output=True, text=True, check=True, timeout=20)
        self.assertEqual(json.loads(result.stdout), json.loads((BASE / 'histogram.json').read_text()))


if __name__ == '__main__':
    unittest.main()
