"""Finite identities for the structural proof; no homology model is assumed."""
import importlib.util
from pathlib import Path
import unittest

ROOT = Path(__file__).resolve().parents[1]
spec = importlib.util.spec_from_file_location(
    'fermat_polarization_arithmetic',
    ROOT/'experiments/fermat_polarization_v151/arithmetic_candidate.py')
arithmetic = importlib.util.module_from_spec(spec)
spec.loader.exec_module(arithmetic)


class RestrictedPolarizationArithmetic(unittest.TestCase):
    def test_integral_separation_and_discriminant_group(self):
        result = arithmetic.check()
        self.assertEqual(result['bezout_coefficients'], [1, 0, 0, 0, 0, 0, 0])
        self.assertEqual(result['primitive_type'], [1, 1, 1, 3, 3, 21])
        self.assertEqual(result['polarization_degree'], 35721)
        self.assertEqual(result['product_of_primitive_elementary_divisors'], 189)


if __name__ == '__main__':
    unittest.main()
