"""Run certificate commands with complete logs and atomic live progress.

``execute_tasks(tasks, workers, root, output_dir)`` returns ``TaskResult``
objects in input order.  Commands run without a shell, in ``root``, with at
most four children at once.  Each child's stdout and stderr share one binary
log; ``stdout`` in the returned result is the complete merged log decoded
as UTF-8 with replacement.  Launch errors have ``status == 'error'`` and
``returncode is None``: callers must test status, not return-code truthiness.

Use a dedicated output directory for each run.  Existing progress or task
logs are refused; nothing is resumed, cached, or skipped.  ``progress.json``
is replaced atomically after each transition.  START/DONE notices go only to
stderr, leaving callers free to render their legacy stdout in task order.
"""

from concurrent.futures import ThreadPoolExecutor
from dataclasses import dataclass
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import threading
import time
import traceback


@dataclass(frozen=True)
class TaskResult:
    label: str
    command: tuple[str, ...]
    status: str
    returncode: int | None
    stdout: str
    error: str | None
    pid: int | None
    log_path: str
    started_at: str
    finished_at: str
    duration_seconds: float


def _timestamp():
    return datetime.now(timezone.utc).isoformat(timespec="milliseconds")


def _atomic_json(path, data):
    """Readers see either the preceding complete snapshot or the new one."""
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w", encoding="utf-8", dir=path.parent,
            prefix=".progress-", suffix=".tmp", delete=False,
        ) as stream:
            temporary = Path(stream.name)
            json.dump(data, stream, indent=2, sort_keys=True)
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def execute_tasks(tasks, workers, root, output_dir):
    """Execute every task and return ordered results, including failures.

    ``tasks`` is an iterable of ``(unique_label, command_argument_sequence)``.
    Positive integer worker requests are capped at four.  Every launched
    child is waited for, including after a task-level exception.  Invalid
    inputs fail before any subprocess is launched.  A reporting filesystem
    failure may raise; the executor still waits for all submitted workers.
    """
    if isinstance(workers, bool) or not isinstance(workers, int) or workers < 1:
        raise ValueError("workers must be a positive integer")
    prepared, labels = [], set()
    for label, command in tasks:
        if not isinstance(label, str) or not label:
            raise ValueError("task labels must be nonempty strings")
        if label in labels:
            raise ValueError(f"duplicate task label: {label!r}")
        labels.add(label)
        if isinstance(command, (str, bytes, os.PathLike)):
            raise ValueError(f"command for {label!r} must be an argument sequence")
        arguments = tuple(os.fsdecode(os.fspath(part)) for part in command)
        if not arguments:
            raise ValueError(f"command for {label!r} must not be empty")
        prepared.append((label, arguments))

    root = Path(root).resolve()
    output_dir = Path(output_dir).resolve()
    progress_path = output_dir / "progress.json"
    records = []
    for index, (label, command) in enumerate(prepared, 1):
        slug = re.sub(r"[^A-Za-z0-9_.-]+", "_", label).strip("._-")[:80] or "task"
        records.append({
            "index": index, "label": label, "command": list(command),
            "status": "pending", "pid": None, "started_at": None,
            "finished_at": None, "duration_seconds": None,
            "returncode": None, "error": None,
            "log_path": str(output_dir / f"{index:04d}-{slug}.log"),
        })
    for path in [progress_path] + [Path(record["log_path"]) for record in records]:
        if path.exists():
            raise FileExistsError(f"refusing to overwrite execution artifact: {path}")
    output_dir.mkdir(parents=True, exist_ok=True)
    worker_count = min(workers, 4, len(prepared)) if prepared else 0
    run_start = time.monotonic()
    snapshot = {
        "schema_version": 1, "root": str(root), "status": "running",
        "requested_workers": workers, "workers": worker_count,
        "started_at": _timestamp(), "updated_at": None,
        "finished_at": None, "duration_seconds": None, "tasks": records,
    }
    lock = threading.Lock()

    def publish():
        snapshot["updated_at"] = _timestamp()
        _atomic_json(progress_path, snapshot)

    def notice(kind, record):
        # JSON quoting keeps labels with newlines on a single progress line.
        label = json.dumps(record["label"], ensure_ascii=True)
        tail = (f" pid={record['pid']} log={record['log_path']}" if kind == "START"
                else f" status={record['status']} returncode={record['returncode']}"
                     f" duration={record['duration_seconds']:.3f}s")
        print(f"{kind} {record['index']:04d}/{len(records):04d} {label}{tail}",
              file=sys.stderr, flush=True)

    with lock:
        publish()

    def run(index):
        label, command = prepared[index]
        record = records[index]
        start, started_at = time.monotonic(), _timestamp()
        process = None
        returncode = None
        error = None
        log_path = Path(record["log_path"])
        with lock:
            record.update(status="running", started_at=started_at)
            publish()
            notice("START", record)
        try:
            # Direct file redirection avoids pipe-buffer deadlocks and keeps
            # complete bytes on disk even while a long process is running.
            with log_path.open("xb") as stream:
                process = subprocess.Popen(
                    command, cwd=root, stdin=subprocess.DEVNULL,
                    stdout=stream, stderr=subprocess.STDOUT,
                )
                with lock:
                    record["pid"] = process.pid
                    publish()
                returncode = process.wait()
        except Exception as exc:
            error = f"{type(exc).__name__}: {exc}"
            diagnostic = "\n[certificate executor error]\n" + traceback.format_exc()
            with log_path.open("ab") as stream:
                stream.write(diagnostic.encode("utf-8", errors="backslashreplace"))
        finally:
            if process is not None:
                # Also reap the child if publishing its PID raised, or if a
                # task-level exception happened after a successful launch.
                returncode = process.wait()
        stdout = log_path.read_bytes().decode("utf-8", errors="replace")
        status = "error" if error is not None else "passed" if returncode == 0 else "failed"
        finished_at, duration = _timestamp(), time.monotonic() - start
        result = TaskResult(
            label=label, command=command, status=status,
            returncode=returncode, stdout=stdout, error=error,
            pid=process.pid if process is not None else None,
            log_path=str(log_path), started_at=started_at,
            finished_at=finished_at, duration_seconds=duration,
        )
        with lock:
            record.update(status=status, returncode=returncode, error=error,
                          finished_at=finished_at, duration_seconds=duration)
            publish()
            notice("DONE", record)
        return result

    results = []
    if prepared:
        with ThreadPoolExecutor(max_workers=worker_count) as executor:
            futures = [executor.submit(run, index) for index in range(len(prepared))]
            # Workers publish completion as it happens; only the returned
            # result list waits in input order.
            results = [future.result() for future in futures]
    with lock:
        snapshot.update(
            status=("error" if any(r.status == "error" for r in results)
                    else "failed" if any(r.status == "failed" for r in results) else "passed"),
            finished_at=_timestamp(), duration_seconds=time.monotonic() - run_start,
        )
        publish()
    return results
