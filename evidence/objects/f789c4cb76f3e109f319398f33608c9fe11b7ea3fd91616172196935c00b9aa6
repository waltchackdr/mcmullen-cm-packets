"""Retained exact B/C identities; human classification proof is separate."""
import json
from pathlib import Path
import subprocess
import sys
import unittest

ROOT=Path(__file__).resolve().parents[1]
CERT=ROOT/'certificates/actual_bc_polarizations_v135.py'

class ActualBCPolarizations(unittest.TestCase):
    def test_lattice_and_polarization_witness(self):
        run=subprocess.run([sys.executable,'-B',str(CERT)],capture_output=True,
                           text=True,check=True,timeout=25)
        expected=json.loads((ROOT/'certificates/actual_bc_polarizations_data.json').read_text())
        self.assertEqual(json.loads(run.stdout),expected)

    def test_optimized_python_is_rejected(self):
        run=subprocess.run([sys.executable,'-O','-B',str(CERT)],capture_output=True,
                           text=True,timeout=25)
        self.assertNotEqual(run.returncode,0)
        self.assertIn('Enabled assertions required',run.stderr)

if __name__=='__main__':unittest.main()
