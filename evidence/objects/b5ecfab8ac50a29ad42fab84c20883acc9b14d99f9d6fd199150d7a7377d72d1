#!/usr/bin/env python3
"""Bounded exact regression for the all-powers formula; not its proof.

Enumerate all pair-count differences on powers one and two, checking each
against every original signed cocharacter row. Independently compare the
result with the closed polynomial formula from the structural argument.
No geometric search, floating point, or new algebraicity premise is used.
"""
from hashlib import sha256
from itertools import product
from math import comb
from pathlib import Path
import json

ROOT = Path(__file__).resolve().parent
INPUT_SHA = "2135edfe6a09b1a2c51a254f80e4570a761674e5be3208c15c549087f225917e"


def mul(a, b):
    c = [0] * (len(a) + len(b) - 1)
    for i, x in enumerate(a):
        for j, y in enumerate(b):
            c[i + j] += x * y
    return c


def power(a, n):
    result = [1]
    for _ in range(n):
        result = mul(result, a)
    return result


def fixed_difference(n, d):
    """Coefficient in cohomological degree for a-b=d in one weight pair."""
    result = [0] * (2*n + 1)
    for a in range(n+1):
        b = a-d
        if 0 <= b <= n:
            result[a+b] += comb(n, a)*comb(n, b)
    return result


def direct_count(rows, n):
    result = [0] * (12*n + 1)
    accepted = []
    for d in product(range(-n, n+1), repeat=6):
        if any(sum(x*y for x, y in zip(row, d)) for row in rows):
            continue
        accepted.append(list(d))
        term = [1]
        for x in d:
            term = mul(term, fixed_difference(n, x))
        for k, v in enumerate(term):
            result[k] += v
    assert all(v == 0 for v in result[1::2])
    return result[::2], accepted


def formula(n):
    result = [0] * (6*n + 1)
    for d in range(n+1):
        one_pair = [comb(n, k+d)*comb(n, k) for k in range(n-d+1)]
        term = power(one_pair, 6)
        multiplicity = 1 if d == 0 else 2
        for k, v in enumerate(term):
            result[3*d+k] += multiplicity*v
    return result


def check():
    raw = (ROOT / "primary.json").read_bytes()
    assert sha256(raw).hexdigest() == INPUT_SHA
    source = json.loads(raw)
    exceptional = [x for x in source["orbits"] if not x["divisor_generated"]]
    assert len(exceptional) == 2
    result = []
    for record in exceptional:
        rows = record["circle_sign_rows_conjugate_pair_coordinates"]
        for n in (1, 2):
            counts, differences = direct_count(rows, n)
            assert counts == formula(n)
            assert counts == counts[::-1]
            assert len(differences) == 2*n+1
            if n == 1:
                assert counts == record["hodge_dimensions_codimensions_0_through_6"]
            result.append({"representative": record["representative"], "power": n,
                           "hodge_dimensions_by_codimension": counts,
                           "difference_vectors_tested": (2*n+1)**6,
                           "invariant_difference_vectors": differences})
    assert sha256((ROOT / "primary.json").read_bytes()).hexdigest() == INPUT_SHA
    return {"status": "PASS_BOUNDED_FORMULA_REGRESSION_NOT_ALL_POWERS_PROOF",
            "input_sha256": INPUT_SHA, "records": result,
            "new_geometry": False, "algebraicity_proved_by_this_check": False}


if __name__ == "__main__":
    assert __debug__
    import resource
    import signal
    resource.setrlimit(resource.RLIMIT_CPU, (15, 16))
    signal.alarm(25)
    print(json.dumps(check(), sort_keys=True, indent=2))
