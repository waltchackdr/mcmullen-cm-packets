        attempts=state['jobs'][self.runner.job_key(label,'prep','primary')]['attempts']
        self.assertEqual(len(attempts),1)
        self.assertEqual(attempts[0]['status'],'INTERRUPTED')
        self.assertTrue((self.campaign/relative/'partial.json').exists())
        self.assertTrue(self.runner.eligible(self.campaign,self.runner.read(self.campaign/'manifest.json'),
                        state,(label,'prep','primary')))

    def test_live_lease_recovered_before_any_duplicate_launch(self):
        label=self.runner.CONTROLS[0]
        self.initialize(controls=[label])
        relative='attempts/'+self.runner.slug(label)+'/prep-primary-01'
        intent={'status':'RUNNING','directory':relative,'task':[label,'prep','primary']}
        self.save(self.campaign/relative/'attempt.json',intent)
        self.save(self.campaign/relative/'lease.json',{'pid':os.getpid(),'parent_pid':os.getppid()})
        with patch.object(self.runner,'launch',side_effect=AssertionError('duplicate launch')):
            with self.assertRaisesRegex(RuntimeError,'may still be alive'):
                self.run_queue()
        self.assertEqual(self.runner.read(self.campaign/relative/'attempt.json'),intent)


class ChildWrapper(unittest.TestCase):
    def test_child_applies_actual_cpu_and_file_caps(self):
        with tempfile.TemporaryDirectory() as d:
            # A Python child prints its inherited limits; this is not research math.
            command=[sys.executable,'-I',str(ROOT/HERE/'child.py'),'--cpu','2','--memory-mib','256',
                     '--file-mib','1','--lease',str(Path(d)/'lease.json'),
                     '--parent-pid',str(os.getpid()),'--',sys.executable,'-I','-c',
                     'import json,resource;print(json.dumps({"cpu":resource.getrlimit(resource.RLIMIT_CPU),"file":resource.getrlimit(resource.RLIMIT_FSIZE)}))']
            result=subprocess.run(command,capture_output=True,text=True,timeout=3)
            self.assertEqual(result.returncode,0,result.stderr)
            limits=json.loads(result.stdout)
            self.assertEqual(limits['cpu'],[2,3])
            self.assertEqual(limits['file'],[1048576,1048576])
            lease=json.loads((Path(d)/'lease.json').read_text())
            self.assertEqual(lease['parent_pid'],os.getpid())
            self.assertGreater(lease['pid'],0)

    def test_child_rejects_wrong_parent_before_lease_or_payload(self):
        with tempfile.TemporaryDirectory() as d:
            lease=Path(d)/'lease.json'
            payload=Path(d)/'payload.txt'
            command=[sys.executable,'-I',str(ROOT/HERE/'child.py'),'--cpu','2','--memory-mib','256',
                     '--file-mib','1','--lease',str(lease),'--parent-pid',str(os.getpid()+10000),
                     '--',sys.executable,'-I','-c',f'open({str(payload)!r},"w").write("ran")']
            result=subprocess.run(command,capture_output=True,text=True,timeout=3)
            self.assertNotEqual(result.returncode,0)
            self.assertIn('Coordinator disappeared',result.stderr)
            self.assertFalse(lease.exists())
            self.assertFalse(payload.exists())


