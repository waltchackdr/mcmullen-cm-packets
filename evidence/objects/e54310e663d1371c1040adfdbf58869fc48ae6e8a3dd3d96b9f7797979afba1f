"""Bounded independent residue-field kernel check using the adopted F729 model.

No producer import and no new proof of the global unit image or geometric type.
Unlike the producer's F27 slope model, use the degree-six residue ring, its
Frobenius fixed field, and the actual adopted unit residues z and gamma.
"""
from collections import deque
from functools import lru_cache
from pathlib import Path
import hashlib
import json
import math
import resource
import signal


def main():
    resource.setrlimit(resource.RLIMIT_CPU, (20, 20))
    signal.alarm(30)
    here = Path(__file__).resolve().parent
    root = here.parents[1]
    packet = json.loads((here / 'review_inputs.json').read_text())
    for path, expected in packet['pins'].items():
        assert hashlib.sha256((root / path).read_bytes()).hexdigest() == expected

    # h=t^6-t^5+t^4-t^3+t^2-t+1, irreducible by adopted C63.
    digits = [tuple((n // (3 ** i)) % 3 for i in range(6)) for n in range(729)]
    encode = lambda a: sum((v % 3) * 3 ** i for i, v in enumerate(a))
    add = lambda a, b: encode([x + y for x, y in zip(digits[a], digits[b])])
    neg = lambda a: encode([-x for x in digits[a]])

    @lru_cache(maxsize=30000)
    def mul(a, b):
        c = [0] * 11
        for i, x in enumerate(digits[a]):
            for j, y in enumerate(digits[b]):
                c[i + j] += x * y
        for i in range(10, 5, -1):
            coefficient = c[i] % 3
            for j in range(6):
                c[i - 6 + j] -= coefficient * (1 if j % 2 == 0 else -1)
        return encode(c[:6])

    def power(a, n):
        answer = 1
        while n:
            if n & 1:
                answer = mul(answer, a)
            a = mul(a, a)
            n >>= 1
        return answer

    fixed = frozenset(a for a in range(729) if power(a, 27) == a)
    assert len(fixed) == 27
    assert all(power(a, 729) == a for a in range(729))
    lines = {frozenset(mul(a, x) for x in fixed) for a in range(1, 729)}
    assert len(lines) == 28 and all(len(line) == 27 for line in lines)
    frequency = {}
    for line in lines:
        for a in line - {0}:
            frequency[a] = frequency.get(a, 0) + 1
    assert len(frequency) == 728 and set(frequency.values()) == {1}
    z = 3  # the residue of zeta42, encoded as t
    gamma = mul(power(z, 6), add(1, neg(power(z, 2))))
    assert power(z, 14) == 1 and power(z, 7) != 1
    assert mul(gamma, power(power(gamma, 27), 727)) == 2

    def orbit(start):
        seen, pending = {start}, deque([start])
        while pending:
            line = pending.popleft()
            for u in (z, gamma):
                target = frozenset(mul(u, x) for x in line)
                if target not in seen:
                    seen.add(target)
                    pending.append(target)
        return seen

    orbit_R = orbit(fixed)
    s = 0
    for e in (6, 12, 24):
        s = add(s, power(z, e))
    for e in (18, 30, 36):
        s = add(s, neg(power(z, e)))
    assert mul(s, s) == 2
    alpha = mul(2, add(1, s))
    orbit_J = orbit(frozenset(mul(alpha, x) for x in fixed))
    assert len(orbit_R) == len(orbit_J) == 14
    assert not orbit_R & orbit_J and orbit_R | orbit_J == lines

    # A 3-dimensional F3 subspace need not be an F27 line.
    false_kernel = frozenset(a + 3 * b + 9 * c
                             for a in range(3) for b in range(3) for c in range(3))
    assert len(false_kernel) == 27 and false_kernel not in lines
    witness = next((u, x, mul(u, x)) for u in fixed for x in false_kernel
                   if mul(u, x) not in false_kernel)
    assert (3 ** 6 - 1) * (3 ** 5 - 1) * (3 ** 4 - 1) // ((3 ** 3 - 1) * (3 ** 2 - 1) * (3 - 1)) == 33880

    phi_B = {1, 5, 23, 25, 29, 31}
    phi_C = {1, 5, 11, 13, 17, 19}
    assert {19 * a % 42 for a in phi_B} == phi_C
    assert {31 * a % 42 for a in phi_C} == phi_B
    assert 19 * 31 % 42 == 1
    assert [u for u in range(1, 42) if math.gcd(u, 42) == 1
            and {u * a % 42 for a in phi_B} == phi_B] == [1]
    assert 729 // 27 == 27 and 27 * 27 == 729

    result = {
        'status': 'PASS_INDEPENDENT_FINITE_KERNEL_CHECK',
        'packet_pins_verified': len(packet['pins']),
        'actual_adopted_residue_model': 'F3[t]/(t^6-t^5+t^4-t^3+t^2-t+1)',
        'frobenius_fixed_field_size': len(fixed),
        'distinct_k_lines': len(lines), 'line_size': 27,
        'nonzero_partition_size': len(frequency),
        'unit_witness_orbits': {'R_target_C': len(orbit_R), 'J_target_B': len(orbit_J)},
        'negative_control': {'all_F3_dimension3_subspaces': 33880,
                             'non_k_stable_order27_subspace_rejected': True,
                             'witness_u_x_product_encoded': list(witness)},
        'CM_type_re_marking_mod42': {'B_to_C': 19, 'C_to_B': 31},
        'degree_in_either_direction_from_indices': 27,
        'premises_not_reproved': ['C63 actual residue-ring identification and full global-unit-image upper bound',
                                 'Pic(O)=1', 'C66 actual J/R lattices',
                                 'C77 actual factor and full End=M'],
        'producer_implementation_imported': False,
        'scope': 'Finite arithmetic only; human proof supplies all-map completeness and minimum degrees.'}
    (here / 'referee_kernel01.json').write_text(json.dumps(result, indent=2, sort_keys=True) + '\n')
    print(json.dumps(result, indent=2, sort_keys=True))


if __name__ == '__main__':
    main()
