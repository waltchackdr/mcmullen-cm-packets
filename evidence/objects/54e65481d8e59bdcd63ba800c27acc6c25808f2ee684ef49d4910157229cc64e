"""Focused changed admission/completion tests; no cloud or mathematical census."""
import copy
import importlib.util
import json
from pathlib import Path
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[1]
SPEC = importlib.util.spec_from_file_location('worker162',ROOT/'experiments/s_order_census_v162/worker_candidate.py')
WORKER = importlib.util.module_from_spec(SPEC); SPEC.loader.exec_module(WORKER)


def plan(job):
    return {'job_index':job,'concurrency':2,'max_tasks':8,'pins':{},
            'tasks':[{'start':80*job+10*i,'count':10,'max_cpu_seconds':120,
                      'child_wall_seconds':150,'parent_kill_seconds':160} for i in range(8)]}


class ChangedWorkerTests(unittest.TestCase):
    def test_disjoint_admission(self):
        with tempfile.TemporaryDirectory() as tmp:
            for job in (0,1):
                p = plan(job)
                self.assertEqual(WORKER.validate_plan(p,Path(tmp)),p['tasks'])
                for field,value in [('start',1),('count',11),('max_cpu_seconds',121)]:
                    bad = copy.deepcopy(p); bad['tasks'][0][field] = value
                    with self.assertRaises(RuntimeError): WORKER.validate_plan(bad,Path(tmp))

    def test_fail_closed_outputs(self):
        p = plan(0)
        results = [{'status':'EXITED','returncode':0} for _ in range(8)]
        with tempfile.TemporaryDirectory() as tmp:
            out = Path(tmp)
            for i,t in enumerate(p['tasks']):
                d = out/f'task{i:02d}'; d.mkdir()
                rows = [{'catalog_index':j,'status':'EXACT_MODEL_CANDIDATE_NOT_THETA_EVALUATION',
                         'theta_evaluations':0} for j in range(t['start'],t['start']+10)]
                (d/'stdout.jsonl').write_text(''.join(json.dumps(r)+'\n' for r in rows))
            self.assertTrue(WORKER.successful_results(results,out,p['tasks']))
            bad = copy.deepcopy(results); bad[0]['returncode'] = 1
            self.assertFalse(WORKER.successful_results(bad,out,p['tasks']))
            (out/'task00/stdout.jsonl').write_text('')
            self.assertFalse(WORKER.successful_results(results,out,p['tasks']))
            (out/'task00/stdout.jsonl').write_text('{invalid}\n')
            self.assertFalse(WORKER.successful_results(results,out,p['tasks']))


if __name__ == '__main__':
    import resource,signal
    resource.setrlimit(resource.RLIMIT_CPU,(20,20)); signal.alarm(30)
    unittest.main()
