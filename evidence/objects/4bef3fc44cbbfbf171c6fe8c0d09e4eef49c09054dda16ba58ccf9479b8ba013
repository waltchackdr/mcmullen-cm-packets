"""Offline exact package and changed-failure-boundary fixtures; no provider calls."""
import ast
import copy
import hashlib
import importlib.util
import io
import json
from pathlib import Path
import resource
import signal
import sys
import tarfile
import tempfile
import time
from unittest.mock import patch

ROOT=Path(__file__).resolve().parents[2]
BASE=ROOT/'build/s-order-v162/preparation02'


def sha(raw):return hashlib.sha256(raw).hexdigest()
def load(p):return json.loads(Path(p).read_bytes())
def module(path,name):
    spec=importlib.util.spec_from_file_location(name,path)
    m=importlib.util.module_from_spec(spec);spec.loader.exec_module(m);return m
def fail(call):
    try:call()
    except (RuntimeError,ValueError,KeyError,TypeError):return
    raise AssertionError('Invalid input was accepted')


def run():
    current=load(BASE/'execution_candidate.json')
    baseline=load(ROOT/current['baseline_execution_authority']['path'])
    for path,pin in current['pins'].items():assert sha((ROOT/path).read_bytes())==pin,path
    assert current['status']=='CANDIDATE_V162_NOT_AUTHORIZED'
    assert current['local_entrypoint']==baseline['local_entrypoint']
    assert current['execution_distinctions']==baseline['execution_distinctions']
    for key,ref in current['bootstrap_code'].items():
        if key!='job_manifest.json':assert ref==baseline['bootstrap_code'][key]
        raw=(ROOT/ref['path']).read_bytes();assert len(raw)==ref['bytes'] and sha(raw)==ref['sha256']
    session_raw=(ROOT/current['session_manifest']['path']).read_bytes()
    assert sha(session_raw)==current['session_manifest']['sha256']
    assert session_raw==(json.dumps(json.loads(session_raw),sort_keys=True)+'\n').encode()
    assert current['bootstrap_code']['job_manifest.json']==current['session_manifest']
    mapping=load(BASE/'source_mapping.json');indices=[];archives=[];jobmanifests=[]
    oldpacket=load(ROOT/baseline['jobs'][0]['path'])
    worker=module(ROOT/'experiments/s_order_census_v162/worker_candidate.py','refworker162')
    pipeline=module(ROOT/'experiments/s_order_census_v162/pipeline_candidate.py','refpipeline162')
    with tempfile.TemporaryDirectory() as tmp:
        tmp=Path(tmp)
        for job,ref in enumerate(current['jobs']):
            raw=(ROOT/ref['path']).read_bytes();assert sha(raw)==ref['sha256'] and len(raw)==ref['bytes']
            packet=json.loads(raw);assert packet['source_mapping']==mapping
            assert packet['uploads']['pipeline']['path']=='experiments/s_order_census_v162/pipeline_candidate.py'
            for key in ('setup','selector'):assert packet['uploads'][key]==oldpacket['uploads'][key]
            for key,entry in packet['code'].items():
                if key!='job_manifest.json':assert entry==oldpacket['code'][key]
            jmraw=(ROOT/packet['code']['job_manifest.json']['path']).read_bytes()
            jm=json.loads(jmraw);jobmanifests.append(jm)
            assert jmraw==(json.dumps(jm,sort_keys=True)+'\n').encode()
            for key,entry in packet['uploads'].items():
                value=(ROOT/entry['path']).read_bytes()
                assert sha(value)==entry['sha256'] and len(value)==entry['bytes']
                assert jm['transport']['blobs'][key]=={'sha256':sha(value),'bytes':len(value)}
            folder=BASE/f'job{job}'
            manifest=load(folder/'source_manifest.json')
            tarraw=(folder/'source.tar').read_bytes()
            assert sha(tarraw)==manifest['archive_sha256'] and len(tarraw)==593920
            with tarfile.open(fileobj=io.BytesIO(tarraw),mode='r:') as tar:
                members=tar.getmembers();assert len(members)==10
                assert {m.name for m in members}==set(mapping)|{'experiments/bc_jacobian_v147/certificate_plan_candidate.json'}
                for member in members:
                    assert member.isfile() and not member.name.startswith('/') and '..' not in Path(member.name).parts
                    data=tar.extractfile(member).read()
                    assert manifest['files'][member.name]=={'sha256':sha(data),'bytes':len(data)}
                    expected=(ROOT/mapping[member.name]).read_bytes() if member.name in mapping else (folder/'certificate_plan_candidate.json').read_bytes()
                    assert data==expected
            plan=load(folder/'certificate_plan_candidate.json')
            planraw=(folder/'certificate_plan_candidate.json').read_bytes()
            assert sha(planraw)==manifest['plan_sha256']==jm['transport']['plan_sha256']
            assert plan['pins']=={v:sha((ROOT/p).read_bytes()) for v,p in mapping.items()}
            assert plan['job_index']==job
            dest=tmp/f'unpacked{job}'
            pipeline.unpack(folder/'source.tar',folder/'source_manifest.json',sha((folder/'source_manifest.json').read_bytes()),dest)
            worker.validate_plan(plan,dest)
            frozen=tmp/f'frozen{job}';worker.snapshot(plan,planraw,frozen,dest)
            worker.validate_plan(plan,frozen)
            for t in plan['tasks']:indices.extend(range(t['start'],t['start']+t['count']))
            bad=copy.deepcopy(plan);bad['tasks'][1]['start']=bad['tasks'][0]['start'];fail(lambda:worker.validate_plan(bad,dest))
            bad=copy.deepcopy(plan);bad['job_index']=1-job;fail(lambda:worker.validate_plan(bad,dest))
            # Undo read-only fixture dirs for ordinary TemporaryDirectory cleanup.
            for path in frozen.rglob('*'):
                if path.is_dir():path.chmod(0o700)
            frozen.chmod(0o700)
            archives.append({'job':job,'files':10,'bytes':len(tarraw),'unpack_and_snapshot':'PASS'})
        assert json.loads(session_raw)=={'version':1,'jobs':jobmanifests}
        assert indices==list(range(160))

        plan=load(BASE/'job0/certificate_plan_candidate.json');out=tmp/'outputs';out.mkdir()
        results=[{'status':'EXITED','returncode':0} for _ in range(8)]
        for i,t in enumerate(plan['tasks']):
            d=out/f'task{i:02d}';d.mkdir()
            rows=[{'catalog_index':n,'status':'EXACT_MODEL_CANDIDATE_NOT_THETA_EVALUATION','theta_evaluations':0} for n in range(t['start'],t['start']+10)]
            (d/'stdout.jsonl').write_text(''.join(json.dumps(r)+'\n' for r in rows))
        assert worker.successful_results(results,out,plan['tasks'])
        target=out/'task00/stdout.jsonl';good=target.read_text();rows=[json.loads(l) for l in good.splitlines()]
        for changed in (rows[:-1],rows+[rows[-1]],list(reversed(rows))):
            target.write_text(''.join(json.dumps(r)+'\n' for r in changed));assert not worker.successful_results(results,out,plan['tasks'])
        bad=copy.deepcopy(rows);bad[0]['catalog_index']=10
        target.write_text(''.join(json.dumps(r)+'\n' for r in bad));assert not worker.successful_results(results,out,plan['tasks'])
        bad=copy.deepcopy(rows);bad[0]['theta_evaluations']=1
        target.write_text(''.join(json.dumps(r)+'\n' for r in bad));assert not worker.successful_results(results,out,plan['tasks'])
        target.write_text(good)
        badresults=copy.deepcopy(results);badresults[0]['returncode']=1
        assert not worker.successful_results(badresults,out,plan['tasks'])
        # Invoke the actual changed pipeline main with only stage execution
        # mocked. Real unpack/bindings/setup-source handling remain active.
        packet=load(BASE/'job0/execution_packet.json')
        setup=packet['uploads']['setup'];stages=[]
        def fake_run(command,root,label,env,timeout):
            stages.append(label)
            if label=='setup':
                (root/'setup').mkdir()
                runtime={'status':'ACTUAL_RUNTIME_OBSERVED_PENDING_REVIEW'}
                raw=json.dumps(runtime).encode();(root/'setup/runtime.json').write_bytes(raw)
                (root/'setup/setup_complete.json').write_text(json.dumps({'runtime_sha256':sha(raw),'status':'SETUP_COMPLETE_NOT_AUTHORIZED_FOR_THETA'}))
                return 0
            assert label=='benchmark';return 17
        args=['pipeline','--source-tar',str(BASE/'job0/source.tar'),'--source-manifest',str(BASE/'job0/source_manifest.json'),
              '--manifest-sha256',sha((BASE/'job0/source_manifest.json').read_bytes()),'--setup-source',str(ROOT/setup['path']),
              '--setup-sha256',setup['sha256'],'--plan-sha256',sha((BASE/'job0/certificate_plan_candidate.json').read_bytes()),
              '--root',str(tmp/'pipeline'),'--local-delete-epoch',str(time.time()+600)]
        handlers={sig:signal.getsignal(sig) for sig in (signal.SIGALRM,signal.SIGINT,signal.SIGTERM)}
        try:
            with patch.object(sys,'argv',args),patch.object(pipeline.platform,'system',return_value='Linux'),patch.object(pipeline.platform,'machine',return_value='x86_64'),patch.dict(pipeline.os.environ,{'RUNPOD_POD_ID':'OFFLINE_FIXTURE'}),patch.object(pipeline,'run',fake_run):
                fail(pipeline.main)
        finally:
            signal.alarm(0)
            for sig,h in handlers.items():signal.signal(sig,h)
        state=load(tmp/'pipeline/pipeline.json')
        assert stages==['setup','benchmark'] and state['status']=='PIPELINE_FAILED' and state['benchmark_returncode']==17
        # Test the exact unchanged run_queue body without importing provider code.
        tree=ast.parse((ROOT/current['local_entrypoint']).read_text())
        fn=next(n for n in tree.body if isinstance(n,ast.FunctionDef) and n.name=='run_queue')
        ns={'request':None,'execute_job':None,'time':time,'Path':Path,'json':json,'sha':sha,'require':worker.require,'save':worker.save}
        exec(compile(ast.Module(body=[fn],type_ignores=[]),'<pinned run_queue>','exec'),ns)
        called=[]
        def stopped(*args,**kwargs):called.append(1);return {'remote_stage':'PIPELINE_ENDED','returncode':17}
        queueout=tmp/'queue';queueout.mkdir()
        fail(lambda:ns['run_queue']('OFFLINE','OFFLINE',[(None,{}, {},None)]*2,queueout,time.time(),time.time()+1200,time.time()+1500,'fixture',execute=stopped))
        assert len(called)==1
    return {'status':'PASS','candidate_pins_verified':len(current['pins']),'current_status_not_dispatchable':True,
            'unchanged_bootstrap_and_local_entrypoint':'BASELINE_IDENTICAL except canonical session manifest',
            'archives':archives,'all_160_indices_exactly_once':True,'virtual_mapping':'Archive bytes equal mapped sources; worker and plan historical names intentional',
            'negative_completion_fixtures':['short','extra','reordered','wrong index','theta evaluation','nonzero child'],
            'pipeline_nonzero_worker_fixture':'PIPELINE_FAILED, returncode17 retained',
            'queue_nonzero_pipeline_fixture':'First job only; second not admitted',
            'provider_calls':0,'child_mathematical_processes':0,'full_suite':False}


if __name__=='__main__':
    resource.setrlimit(resource.RLIMIT_CPU,(20,20));signal.alarm(30)
    print(json.dumps(run(),indent=2))
