"""Replay the exact order-generator input and enforce enabled assertions.

This does not test or replace the human proof of the polarization classification.
"""
import json
from pathlib import Path
import subprocess
import sys
import unittest

CERT = Path(__file__).resolve().parents[1] / 'certificates/cm_polarization_conductor_v135.py'

class PolarizationConductorInput(unittest.TestCase):
    def test_exact_generator_bridge(self):
        run = subprocess.run([sys.executable, '-B', str(CERT)], capture_output=True,
                             text=True, check=True, timeout=25)
        result = json.loads(run.stdout)
        self.assertEqual(result['status'], 'CM_POLARIZATION_CONDUCTOR_INPUT_PASS')
        self.assertEqual(result['norm_beta_over_q'], 1)
        self.assertTrue(result['identity_beta_equals_q_times_unit'])
        self.assertEqual(result['beta_over_q'], [1,1,0,0,0,1,1,0,-1,0,0,1])

    def test_optimized_python_is_rejected(self):
        run = subprocess.run([sys.executable, '-O', '-B', str(CERT)],
                             capture_output=True, text=True, timeout=25)
        self.assertNotEqual(run.returncode, 0)
        self.assertIn('Enabled assertions are required', run.stderr)

if __name__ == '__main__':
    unittest.main()
