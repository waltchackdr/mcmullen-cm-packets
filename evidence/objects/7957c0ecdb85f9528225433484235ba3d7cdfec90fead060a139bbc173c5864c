"""Bounded proposed read helper: no provider, credentials, or real sleeps."""
import importlib.util
from pathlib import Path
import unittest
p=Path(__file__).resolve().parents[1]/'experiments/bc_jacobian_v147/runtime/read_retry_candidate.py'
s=importlib.util.spec_from_file_location('retry',p);m=importlib.util.module_from_spec(s);s.loader.exec_module(m)

class Tests(unittest.TestCase):
    def run_case(self,call,events=None,clock=lambda:0,wall=lambda:0,kind='artifact'):
        return m.read_once_or_retry(call, (events if events is not None else []).append,
            kind=kind,monotonic_deadline=20,wall_deadline=20,clock=clock,wall=wall)
    def test_timeout_then_success_each_kind(self):
        for kind in ('snapshot','artifact'):
            calls=[];events=[]
            def call(timeout):
                calls.append(timeout)
                if len(calls)==1:raise TimeoutError()
                return b'exact immutable bytes'
            self.assertEqual(self.run_case(call,events,kind=kind),b'exact immutable bytes')
            self.assertEqual(calls,[15,15]);self.assertEqual(len(events),1)
    def test_two_timeouts_stop(self):
        calls=[];events=[]
        def call(t):calls.append(t);raise TimeoutError()
        with self.assertRaises(TimeoutError):self.run_case(call,events)
        self.assertEqual(len(calls),2);self.assertEqual(len(events),2)
    def test_expired_clock_no_second_call(self):
        for which in ('clock','wall'):
            now=[0];calls=[]
            def call(t):calls.append(t);now[0]=20;raise TimeoutError()
            with self.assertRaises(TimeoutError):self.run_case(call,**{which:lambda:now[0]})
            self.assertEqual(len(calls),1)
    def test_invalid_kind_never_calls(self):
        with self.assertRaises(ValueError):self.run_case(lambda t:self.fail(),kind='start')
    def test_other_errors_not_retried(self):
        calls=[]
        def call(t):calls.append(t);raise ValueError('malformed')
        with self.assertRaises(ValueError):self.run_case(call)
        self.assertEqual(len(calls),1)
    def test_late_success_rejected(self):
        now=[0]
        def call(t):now[0]=21;return b'late'
        with self.assertRaises(TimeoutError):self.run_case(call,wall=lambda:now[0])
    def test_remaining_time_caps_second_attempt(self):
        now=[0];calls=[]
        def call(t):
            calls.append(t)
            if len(calls)==1:now[0]=18;raise TimeoutError()
            return b'ok'
        self.assertEqual(self.run_case(call,clock=lambda:now[0]),b'ok')
        self.assertEqual(calls,[15,2])

if __name__=='__main__':unittest.main()
