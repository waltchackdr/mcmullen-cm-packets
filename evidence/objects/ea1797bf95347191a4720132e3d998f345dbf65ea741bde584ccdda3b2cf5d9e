"""Tiny independent exact identities for C94; no class-field computation."""
import json,math,resource,signal,time
from pathlib import Path
resource.setrlimit(resource.RLIMIT_CPU,(20,20));signal.alarm(30);start=time.monotonic()
def mul(a,b):
 c=[0]*(len(a)+len(b)-1)
 for i,x in enumerate(a):
  for j,y in enumerate(b):c[i+j]+=x*y
 return c
def rem(a,f):
 a=a[:]
 while len(a)>=len(f):
  x=a[-1];n=len(a)-len(f)
  for i,y in enumerate(f):a[n+i]-=x*y
  a.pop()
 return a+[0]*(len(f)-1-len(a))
assert rem(mul([1,2],[1,2]),[1,1,1])==[-3,0]
s=[0,1,1,-1,1,-1,-1]
assert rem(mul(s,s),[1]*7)==[-7,0,0,0,0,0]
assert next(d for d in range(1,7) if pow(3,d,7)==1)==6
# Norm((X²+1)-omega X), Tr(omega)=1 and N(omega)=-5.
f=mul([1,0,1],[1,0,1]);f[1]-=1;f[3]-=1;f[2]-=5
assert f==[1,-1,-3,-1,1]
# Bareiss determinant of Sylvester matrix, hence quartic discriminant.
a=list(reversed(f));b=[4,-3,-6,-1];n=7
matrix=[]
for k in range(3):matrix.append([0]*k+a+[0]*(2-k))
for k in range(4):matrix.append([0]*k+b+[0]*(3-k))
sign=1;previous=1
for k in range(n-1):
 if matrix[k][k]==0:
  r=next(i for i in range(k+1,n) if matrix[i][k]);matrix[k],matrix[r]=matrix[r],matrix[k];sign=-sign
 pivot=matrix[k][k]
 for i in range(k+1,n):
  for j in range(k+1,n):
   value=matrix[i][j]*pivot-matrix[i][k]*matrix[k][j];assert value%previous==0;matrix[i][j]=value//previous
 for i in range(k+1,n):matrix[i][k]=0
 previous=pivot
disc=sign*matrix[-1][-1];assert disc==-1323==-3*21**2
assert math.gcd(286,728)==26 and 728//26==28 and 728//364==2
# Parity character: g^(286n) belongs U14=<g^52> iff n is even.
assert all(((286*n)%52==0)==(n%2==0) for n in range(728))
out={'status':'PASS','sqrt_minus3_identity':True,'sqrt_minus7_identity':True,'ord7_of3':6,'quartic_coefficients_ascending':f,'quartic_polynomial_discriminant':disc,'residue_reflex_image_order':28,'induced_ray_character':'residue exponent parity modulo U364','ray_class_order_given_adopted_h1_unit_image':2,'scope':'Exact small identities only; ideal/discriminant/conductor/action proofs remain human arguments','wall_seconds':time.monotonic()-start}
Path(__file__).with_suffix('.json').write_text(json.dumps(out,indent=2,sort_keys=True)+'\n');print(json.dumps(out,sort_keys=True))
