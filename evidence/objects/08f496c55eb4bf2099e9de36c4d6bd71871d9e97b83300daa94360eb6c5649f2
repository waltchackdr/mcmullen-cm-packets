"""Replay the bounded type table against pinned accepted census evidence."""
import json
import subprocess
import sys
import unittest
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
BASE = ROOT / 'experiments/simple_cm_unmarked_v145'


class SimplePrincipalTableTest(unittest.TestCase):
    def test_replay_pinned_type_table(self):
        proc = subprocess.run([sys.executable, str(BASE / 'derive.py')],
                              capture_output=True, text=True, check=True, timeout=20)
        self.assertEqual(json.loads(proc.stdout), json.loads((BASE / 'table.json').read_text()))


if __name__ == '__main__':
    unittest.main()
