"""Replay small independent identities without rewriting frozen referee receipts."""
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[1]


class RayActionFieldArithmetic(unittest.TestCase):
    def replay(self, name):
        source = ROOT / "experiments/all_underlying_galois_v165" / name
        with tempfile.TemporaryDirectory() as folder:
            target = Path(folder) / name
            target.write_bytes(source.read_bytes())
            result = subprocess.run([sys.executable, str(target)], capture_output=True,
                                    text=True, check=True, timeout=20)
            return json.loads(result.stdout)

    def test_quartic_and_residue_character(self):
        result = self.replay("referee_ray_arithmetic01.py")
        self.assertEqual(result["status"], "PASS")
        self.assertEqual(result["quartic_polynomial_discriminant"], -1323)
        self.assertEqual(result["residue_reflex_image_order"], 28)

    def test_jordan_bound_and_kernel_obstruction(self):
        result = self.replay("referee_faithfulness01.py")
        self.assertEqual(result["total_invariant_subspaces"], 40)
        self.assertLess(result["fixed_root_orbit_subspace_union_bound"],
                        result["obstructed_subspaces"])
        self.assertTrue(result["normal_closures_outside_C3_contain_central_involution"])


if __name__ == "__main__":
    unittest.main()
