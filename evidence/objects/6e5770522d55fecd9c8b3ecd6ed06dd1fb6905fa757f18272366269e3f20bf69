def beneath(root,name):
 need(type(name)is str and name and not Path(name).is_absolute() and '..'not in Path(name).parts,'Unsafe relative path')
 path=safe(Path(root)/name);need(path.is_relative_to(safe(root)),'Path escapes root');return path
def distinct_output(output,roots):
 output=safe(output);need(not output.exists(),'Fresh output required')
 for root in roots:
  root=safe(root);need(not output.is_relative_to(root)and not root.is_relative_to(output),'Output overlaps evidence')
 return output
def counts(value):
