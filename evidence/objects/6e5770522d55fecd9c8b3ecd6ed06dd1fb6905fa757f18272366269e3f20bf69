def need(ok,message):
 if not ok:raise ValueError(message)
def encode(v):return(json.dumps(v,sort_keys=True,separators=(',',':'),allow_nan=False)+'\n').encode()
def object_sha(v):return hashlib.sha256(encode(v)).hexdigest()
def safe(p):
 p=Path(os.path.abspath(p));need(all(not q.is_symlink()for q in(p,*p.parents)),'Symlink path');return p
def regular(p):
 p=safe(p);s=p.stat();need(stat.S_ISREG(s.st_mode)and s.st_nlink==1,'Unaliased regular file');return p
def sha(p):
 h=hashlib.sha256()
 with regular(p).open('rb')as f:
  for b in iter(lambda:f.read(1048576),b''):h.update(b)
 return h.hexdigest()
def read(p):
 def unique(pairs):
  d={}
  for k,v in pairs:need(k not in d,'Duplicate JSON key');d[k]=v
  return d
 return json.loads(regular(p).read_text(),object_pairs_hook=unique,parse_constant=lambda c:need(False,'Nonfinite JSON'))
def write(p,v):
 p=safe(p);p.parent.mkdir(parents=True,exist_ok=True)
 with p.open('xb')as f:f.write(encode(v));f.flush();os.fsync(f.fileno())
def ref(record,expected=None):
 need(set(record)=={'path','sha256'}and Path(record['path']).is_absolute(),'Exact absolute reference');p=regular(record['path'])
 need(sha(p)==record['sha256']and(expected is None or record['sha256']==expected),'Reference seal');return p

def load(path,name):
 s=importlib.util.spec_from_file_location(name,path);m=importlib.util.module_from_spec(s);s.loader.exec_module(m);return m
