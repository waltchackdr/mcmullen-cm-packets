def tree(root):
 root=safe(root);files={};dirs=[];inodes=set()
 def fail(error):raise error
 for folder,children,names in os.walk(root,followlinks=False,onerror=fail):
  for name in children:
   p=safe(Path(folder)/name);need(p.is_dir(),'Non-directory');dirs.append(p.relative_to(root).as_posix())
  for name in names:
   p=regular(Path(folder)/name);s=p.stat();identity=(s.st_dev,s.st_ino);need(identity not in inodes,'Duplicate inode');inodes.add(identity)
   files[p.relative_to(root).as_posix()]={'bytes':s.st_size,'sha256':sha(p)}
 return{'schema_version':1,'directories':sorted(dirs),'files':dict(sorted(files.items()))}
def copy(source,target,pin):
 import shutil
 source=regular(source);target=safe(target);need(sha(source)==pin and not target.exists(),'Copy input/fresh destination');target.parent.mkdir(parents=True,exist_ok=True)
 shutil.copyfile(source,target);need(sha(source)==pin==sha(target),'Before/after source or copy changed')

