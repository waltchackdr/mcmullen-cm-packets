def load_amendment_chain(x,a,references,anchors=None):
 """Read the complete exact approved step files; shared by the auditor and collectors."""
 need(type(references)is list and len(references)==len(CHAIN_PINS),'Complete ordered amendment references')
 chain=[]
 for refs,pins in zip(references,CHAIN_PINS):
  need(set(refs)=={'configuration','amendment','review','failed_review','source_review'},'Exact amendment references')
  step={}
  for name,ref in refs.items():
   p,value=x.reference(a,ref,pins[name+'_sha256']);digest=sha(p)
   if anchors is not None:anchors[str(p)]=digest
   step[name]=value;step[name+'_sha256']=digest
  chain.append(step)
 return chain


