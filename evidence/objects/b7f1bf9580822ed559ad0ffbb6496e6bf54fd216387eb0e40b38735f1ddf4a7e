"""Tiny abstract coset check for C98; no producer imports or CM enumeration.
Geometric Galois/stabilizer identifications remain adopted C90--C97 premises.
"""
import itertools
import json
import time
from pathlib import Path


def main():
    start = time.monotonic()
    # D8 acts by affine permutations x -> (-1)^b*x+a of Z/4;
    # the second coordinate is translation on the independent Z/3.
    G = [(a, b, k) for a in range(4) for b in range(2) for k in range(3)]
    def mul(x, y):
        a,b,k=x; d,e,l=y
        return ((a+(-1)**b*d)%4, (b+e)%2, (k+l)%3)
    one=(0,0,0); c=(0,1,0); z=(2,0,0); q=(0,0,1)
    def subgroup(gens):
        H={one}
        while True:
            nxt=H | {mul(h,g) for h in H for g in gens}
            if nxt==H: return frozenset(H)
            H=nxt
    def cosets(H):
        return set(frozenset(mul(g,h) for h in H) for g in G)
    def action(g,C): return frozenset(mul(g,x) for x in C)
    rows=[]
    # Per C90/C97: two size4, one size8, four size12, four size24
    # principal orbits. Stabilizers are specified up to conjugacy.
    for size,multiplicity,gens in [(4,2,[q,c]),(8,1,[q]),(12,4,[c]),(24,4,[])]:
        H=subgroup(gens); X=cosets(H)
        assert len(X)==size
        assert all(action(z,x)!=x for x in X)
        fibers={frozenset((x,action(z,x))) for x in X}
        fixed=[x for x in X if action(c,x)==x]
        fixed_fibers=[F for F in fibers if frozenset(action(c,x) for x in F)==F]
        split=[F for F in fixed_fibers if all(x in fixed for x in F)]
        swapped=[F for F in fixed_fibers if all(action(c,x)!=x for x in F)]
        assert len(split)+len(swapped)==len(fixed_fibers)
        assert len(fixed)==2*len(split)
        rows.append(dict(size=size,multiplicity=multiplicity,polarized_fixed=len(fixed),
                         underlying_fixed=len(fixed_fibers),split_fibers=len(split),
                         swapped_fibers=len(swapped)))
    total=lambda key:sum(r['multiplicity']*r[key] for r in rows)
    assert total('polarized_fixed')==28
    assert total('underlying_fixed')==28
    assert total('split_fibers')==14 and total('swapped_fibers')==14
    # Obstructed population is three size8 and116 size24 orbits, each
    # with stabilizer C3 or trivial, so c has no fixed point.
    assert all(not any(action(c,x)==x for x in cosets(subgroup(gs))) for gs in [[q],[]])
    # Exact root-unit cocycle, all actual roots in mu42, not just U14.
    assert all((-e+e)%42==0 for e in range(42))
    # Negative control: incorrectly making c trivial on roots fails for40 roots.
    wrong=sum((-e-e)%42!=0 for e in range(42))
    assert wrong==40
    out={'status':'PASS','scope':'Abstract adopted stabilizer/fiber count and root-exponent cocycle corroboration only',
         'rows':rows,'principal_fixed':28,'minimum_fixed_including_A':29,
         'underlying_fixed_including_A':29,'underlying_real_model_classes_including_A':15,
         'pseudoreal_underlying_classes':14,'principal_R_S':[2,26],
         'real_underlying_quotient_R_S':[1,13],'pseudoreal_R_S':[1,13],
         'root_cocycle_cases':42,'incorrect_trivial_root_action_failures':wrong,
         'wall_seconds':time.monotonic()-start}
    Path(__file__).with_suffix('.json').write_text(json.dumps(out,indent=2,sort_keys=True)+'\n')
    print(json.dumps(out,sort_keys=True))

if __name__=='__main__': main()
