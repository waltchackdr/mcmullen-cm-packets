 # These signed sets exercise its consumer contract, not fresh candidate geometry.
 namespace={'__name__':'positive_witness_contract_only','__file__':str(path)}
 exec(compile(code,str(path),'exec'),namespace)
 for key in POSITIVE_KEYS:
  signed=namespace['ordered'](witnesses['records'][key]['signed_H_selected'],4)
  checked=namespace['positive_witnesses'](key,expected[key],selection[key]['plan_sha256'],expected[key]['counts'],signed,signed)
  need(checked['both_signed_witnesses_present']is True and checked['record_sha256']==expected[key]['positive_witness_record_sha256'],'Actual frozen positive consumer predicate')
 return {'cases':list(POSITIVE_KEYS),'actual_frozen_metadata_predicate_passed':True,'synthetic_candidate_sets_equal_reviewed_signed_witnesses':True,'fresh_geometry_or_POINT_PASS_claimed':False}

