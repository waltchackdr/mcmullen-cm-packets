    data[0]['benchmark/summary.json']=raw(summary);data[0]['benchmark/task00/result.json']=raw(result)
   if label=='missing_task07':data[0].pop('benchmark/task07/stdout.jsonl')
   if label=='runtime_mismatch':data[0]['setup/runtime.json']=raw({'different':True})
   try:evaluate(data,label,cleanup=label!='false_cleanup')
   except (AssertionError,RuntimeError,ValueError,KeyError):rejected.append(label)
   else:raise AssertionError(('Malformed retained stream accepted',label))
 return {'status':'PASS_SYNTHETIC_COLLECTOR_CONTRACT_ONLY','observations':80,'targets':10,'tasks':16,
  'all_observations_inconclusive':True,'task_counts_by_target':{str(i):c['tasks'] for i,c in positive['reported_counts'].items()},
  'negative_rejections':rejected,'actual_runtime_evidence':False,'theta_calls':0,'provider_calls':0,'mathematical_adoption':False}
