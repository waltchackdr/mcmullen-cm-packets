#!/usr/bin/env python3
"""Run the two exact discovery paths for one approved pilot from a frozen copy under hard limits.

Completion means bounded discovery only, never certificate promotion. Each
child gets its own CPU limit and wall deadline; no partial search is resumed.
All artifacts, including failures, are retained in a new output directory.
"""
from datetime import datetime, timezone
from hashlib import sha256
from pathlib import Path
import argparse
import ast
import importlib
import json
import os
import resource
import shutil
import signal
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[2]
HERE = "experiments/broader_geometry_v71"
BACKENDS = ("primary", "sturm")
POINTS = ("R127:pic0:00", "R43_20:pic0:00", "R7sq:pic0:00", "R41_22:pic0:00", "R43_31:pic0:00", "R7:pic0:00", "R127:pic1:00")


def digest(path):
    return sha256(path.read_bytes()).hexdigest()


def stamp():
    return datetime.now(timezone.utc).isoformat()


def terminate_supervisor(signum, frame):
    raise SystemExit(128 + signum)


def kill_group(process):
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait()


def write(path, value):
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, indent=2, sort_keys=True) + "\n")
    temporary.replace(path)


def source_manifest(root):
    paths = {f"{HERE}/run_pilot.py"}
    for backend in BACKENDS:
        relative = f"{HERE}/{backend}.py"
        paths.add(relative)
        tree = ast.parse((root / relative).read_text())
        assignments = [node.value for node in tree.body
                       if isinstance(node, ast.Assign)
                       and any(isinstance(t, ast.Name) and t.id == "SOURCE_PINS"
                               for t in node.targets)]
        if len(assignments) != 1:
            raise ValueError(f"Expected one literal SOURCE_PINS in {relative}")
        pins = ast.literal_eval(assignments[0])
        if not isinstance(pins, dict) or not pins:
            raise ValueError("Missing source closure")
        for path, expected in pins.items():
            resolved = (root / path).resolve()
            if not resolved.is_relative_to(root.resolve()):
                raise ValueError(f"Source outside snapshot: {path}")
            if digest(resolved) != expected:
                raise ValueError(f"Changed pinned source: {path}")
            paths.add(path)
    return {path: digest(root / path) for path in sorted(paths)}


def runtime_manifest():
    executable = Path(sys.executable).resolve()
    result = dict(python_executable=sys.executable,
                  python_resolved=str(executable), python_sha256=digest(executable),
                  python_version=sys.version, packages={})
    for name, version in (("sympy", "1.14.0"), ("mpmath", "1.3.0")):
        module = importlib.import_module(name)
        if module.__version__ != version:
            raise ValueError(f"Expected {name} {version}")
        package = Path(module.__file__).resolve().parent
        result["packages"][name] = dict(version=version, location=str(package),
            source_sha256={p.relative_to(package).as_posix(): digest(p)
                          for p in sorted(package.rglob("*"))
                          if p.is_file() and p.suffix in (".py", ".so", ".dylib", ".pyd")})
    return result


def run_child(command, output, cpu_seconds, wall_seconds, progress):
    """Single-threaded supervisor; timeout and interruption kill the child group."""
    def limits():
        resource.setrlimit(resource.RLIMIT_CPU, (cpu_seconds, cpu_seconds + 1))
        resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
        resource.setrlimit(resource.RLIMIT_FSIZE, (128 * 1024**2, 128 * 1024**2))

    env = dict(os.environ)
    for name in ("PYTHONPATH", "PYTHONOPTIMIZE", "PYTHONSTARTUP"):
        env.pop(name, None)
    env.update(PYTHONDONTWRITEBYTECODE="1", PYTHONUNBUFFERED="1")
    started = time.monotonic()
    row = dict(command=command, started_utc=stamp(), status="running",
               cpu_soft_seconds=cpu_seconds, cpu_hard_seconds=cpu_seconds + 1,
               wall_limit_seconds=wall_seconds, output_file_limit_bytes=128 * 1024**2)
    with (output / "child.log").open("x") as log:
        process = None
        try:
            process = subprocess.Popen(command, cwd="/tmp", env=env, stdout=log,
                                       stderr=subprocess.STDOUT, start_new_session=True,
                                       preexec_fn=limits)
            row["pid"] = process.pid
            progress(dict(row))
            while True:
                remaining = wall_seconds - (time.monotonic() - started)
                if remaining <= 0:
                    row["status"] = "incomplete_wall_limit"
                    kill_group(process)
                    break
                try:
                    process.wait(timeout=min(5, remaining))
                    row["status"] = ("completed_discovery_only" if process.returncode == 0
                                     else "incomplete_cpu_limit" if process.returncode == -signal.SIGXCPU
                                     else "failed_or_interrupted")
                    break
                except subprocess.TimeoutExpired:
                    progress({**row, "updated_utc": stamp(),
                              "wall_seconds": time.monotonic() - started})
        finally:
            if process is not None and process.poll() is None:
                kill_group(process)
    row.update(returncode=process.returncode, finished_utc=stamp(),
               wall_seconds=time.monotonic() - started,
               log_sha256=digest(output / "child.log"))
    progress(dict(row))
    return row


def main():
    if not __debug__:
        raise RuntimeError("Assertions must be enabled")
    signal.signal(signal.SIGTERM, terminate_supervisor)
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--point", choices=POINTS, required=True)
    parser.add_argument("--cpu-seconds", type=int, default=180)
    parser.add_argument("--wall-seconds", type=int, default=240)
    modes = parser.add_mutually_exclusive_group()
    modes.add_argument("--prepare-only", action="store_true")
    modes.add_argument("--entries-only", action="store_true")
    args = parser.parse_args()
    if not (1 <= args.cpu_seconds <= 600 and 1 <= args.wall_seconds <= 900):
        raise ValueError("Require bounded CPU 1..600 and wall 1..900 seconds per path")
    out = args.output.resolve()
    if not out.is_relative_to(ROOT / "build/research-v71"):
        raise ValueError("Output must be under build/research-v71")
    before = source_manifest(ROOT)
    runtime = runtime_manifest()
    out.mkdir(parents=True, exist_ok=False)
    snapshot = out / "source"
    for relative, expected in before.items():
        target = snapshot / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(ROOT / relative, target)
        if digest(target) != expected:
            raise RuntimeError(f"Source changed while copying: {relative}")
    if source_manifest(snapshot) != before:
        raise RuntimeError("Incomplete source snapshot")
    mode = "preparation" if args.prepare_only else "entries" if args.entries_only else "full"
    record = dict(status="running", mode=mode, point_label=args.point,
                  supervisor_pid=os.getpid(), started_utc=stamp(), workers=1,
                  scope="Bounded discovery only; no theorem promotion",
                  source_sha256=before, runtime=runtime, results={})

    def progress(backend, row):
        record["results"][backend] = row
        record["updated_utc"] = stamp()
        write(out / "runtime.json", record)

    write(out / "runtime.json", record)
    try:
        for backend in BACKENDS:
            output = out / backend
            output.mkdir()
            command = [sys.executable, "-B", "-u", str(snapshot / HERE / f"{backend}.py"),
                       "--output", str(output / "artifacts"), "--point", args.point]
            if args.prepare_only:
                command.append("--prepare-only")
            elif args.entries_only:
                command.append("--entries-only")
            run_child(command, output, args.cpu_seconds, args.wall_seconds,
                      lambda row, backend=backend: progress(backend, row))
        record["status"] = ("completed_pending_comparison_and_review"
                            if all(r["status"] == "completed_discovery_only"
                                   for r in record["results"].values())
                            else "incomplete_or_failed")
    except BaseException as exc:
        record.update(status="failed_or_interrupted", error=repr(exc))
        raise
    finally:
        record["changed_sources"] = [p for p, h in before.items()
            if not (ROOT / p).is_file() or digest(ROOT / p) != h
            or not (snapshot / p).is_file() or digest(snapshot / p) != h]
        record["runtime_unchanged"] = runtime_manifest() == runtime
        if record["changed_sources"] or not record["runtime_unchanged"]:
            record["status"] = "failed_source_or_runtime_change"
        record["finished_utc"] = stamp()
        record["artifact_sha256"] = {
            p.relative_to(out).as_posix(): digest(p) for backend in BACKENDS
            for p in sorted((out / backend).rglob("*")) if p.is_file()}
        write(out / "runtime.json", record)
    print(json.dumps(dict(status=record["status"], mode=mode,
                         results={k: {f: v[f] for f in ("status", "wall_seconds", "returncode")}
                                  for k, v in record["results"].items()})), flush=True)
    if record["status"] != "completed_pending_comparison_and_review":
        raise SystemExit(2)


if __name__ == "__main__":
    main()
