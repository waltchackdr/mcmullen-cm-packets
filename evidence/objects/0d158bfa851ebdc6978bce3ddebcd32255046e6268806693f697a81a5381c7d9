"""Small exact ramification/type checks for the provisional geometric follow-up."""
import hashlib
import json
import math
from fractions import Fraction
from pathlib import Path


def require(x, message):
    if not x:
        raise ValueError(message)


def main():
    base = Path(__file__).resolve().parent
    raw = (base / 'table.json').read_bytes()
    table = json.loads(raw)['primitive_orbits']
    signatures = [[sum(k % 3 == a for k in r['representative']) for a in (1, 2)] for r in table]
    require(signatures == [[3, 3], [4, 2], [1, 5], [2, 4]], 'Signatures')
    triple = []
    for n2 in range(9):
        n1 = 8-n2
        if (n1+2*n2) % 3:
            continue
        dims = [-1 + n1*Fraction((-j) % 3, 3) + n2*Fraction((-2*j) % 3, 3) for j in (1, 2)]
        require(all(x.denominator == 1 for x in dims), 'Nonintegral dimensions')
        triple.append({'n1': n1, 'n2': n2, 'dimensions': [int(x) for x in dims]})
    ramification = [[a, b, c] for a in range(4) for b in range(3) for c in range(3)
                    if 7*a+9*b+10*c == 26]
    require(ramification == [[1, 1, 1]], 'Order21 ramification')
    units21 = [a for a in range(21) if math.gcd(a, 21) == 1]
    monodromy = {(7*u, 3*v, (-7*u-3*v) % 21) for u in (1, 2) for v in range(1, 7)}
    require(all(math.gcd(t[2], 21) == 1 for t in monodromy), 'Last inertia not21')
    require({tuple(a*x % 21 for x in (7, 3, 11)) for a in units21} == monodromy,
            'Monodromy not single orbit')
    known = tuple(sorted(x if x % 2 else x+21 for x in (1, 2, 4, 8, 10, 16)))
    units42 = [a for a in range(42) if math.gcd(a, 42) == 1]
    matches = [[a for a in units42 if tuple(sorted(a*x % 42 for x in r['representative'])) == known]
               for r in table]
    require(matches == [[], [], [], [23]], 'Known Jacobian orbit')
    print(json.dumps({'status': 'EXACT_ARITHMETIC_ONLY_GEOMETRIC_PROOF_PENDING',
                      'table_sha256': hashlib.sha256(raw).hexdigest(), 'K3_signatures': signatures,
                      'triple_cover_cases': triple, 'order21_ramification_solutions': ramification,
                      'order21_monodromy_tuples': len(monodromy), 'order21_monodromy_orbits': 1,
                      'known_jacobian_type_lift': known, 'known_jacobian_type_matches': matches}, indent=2))


if __name__ == '__main__':
    main()
