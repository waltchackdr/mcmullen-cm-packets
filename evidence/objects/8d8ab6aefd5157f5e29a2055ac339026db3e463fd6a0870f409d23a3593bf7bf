"""Exact geometric transport witness, separate from its human equivariance proof."""
import json
from pathlib import Path
import subprocess
import sys
import unittest
ROOT=Path(__file__).resolve().parents[1]
CERT=ROOT/'certificates/curve_twist_image_v138.py'
class CurveTwistImage(unittest.TestCase):
    def test_exact_lattice_and_ambient_transport(self):
        run=subprocess.run([sys.executable,'-B',str(CERT)],capture_output=True,
                           text=True,check=True,timeout=25)
        self.assertEqual(json.loads(run.stdout),json.loads(
            (ROOT/'certificates/curve_twist_image_data.json').read_text()))
    def test_disabled_assertions_rejected(self):
        run=subprocess.run([sys.executable,'-O','-B',str(CERT)],capture_output=True,
                           text=True,timeout=25)
        self.assertNotEqual(run.returncode,0)
        self.assertIn('Enabled assertions are required',run.stderr)
if __name__=='__main__':unittest.main()
