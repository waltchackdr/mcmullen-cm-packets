"""Independent C83 finite audit: Sylvester/Bareiss and Frobenius gcd tests.

No producer imports. This certifies finite arithmetic, not unit signatures,
CM geometry, or the enumeration of all maximal isotropic subgroups.
"""
import json

F = [1, 8, 8, -6, -6, 1, 1]
BETA = [-2, -8, -2, 6, 1, -1]


def determinant(a):
    a = [row[:] for row in a]
    sign, previous = 1, 1
    for k in range(len(a) - 1):
        pivot = next((j for j in range(k, len(a)) if a[j][k]), None)
        if pivot is None:
            return 0
        if pivot != k:
            a[k], a[pivot] = a[pivot], a[k]
            sign *= -1
        d = a[k][k]
        for i in range(k + 1, len(a)):
            for j in range(k + 1, len(a)):
                numerator = a[i][j] * d - a[i][k] * a[k][j]
                assert numerator % previous == 0
                a[i][j] = numerator // previous
            a[i][k] = 0
        previous = d
    return sign * a[-1][-1]


def resultant(f, g):
    m, n = len(f) - 1, len(g) - 1
    a = [[0] * (m + n) for _ in range(m + n)]
    for i in range(n):
        a[i][i:i + m + 1] = f[::-1]
    for i in range(m):
        a[n + i][i:i + n + 1] = g[::-1]
    return determinant(a)


def trim(a, p):
    a = [x % p for x in a]
    while a and not a[-1]:
        a.pop()
    return a


def divide(a, b, p):
    a, b = trim(a, p), trim(b, p)
    q = [0] * max(0, len(a) - len(b) + 1)
    while a and len(a) >= len(b):
        k = len(a) - len(b)
        c = a[-1] * pow(b[-1], -1, p) % p
        q[k] = c
        for j, v in enumerate(b):
            a[k + j] -= c * v
        a = trim(a, p)
    return trim(q, p), a


def gcd(a, b, p):
    while b:
        a, b = b, divide(a, b, p)[1]
    return trim([x * pow(a[-1], -1, p) for x in a], p)


def multiply(a, b, p):
    c = [0] * (len(a) + len(b) - 1)
    for i, x in enumerate(a):
        for j, y in enumerate(b):
            c[i + j] += x * y
    return trim(c, p)


def frobenius_minus_x(q, modulus, p):
    a, b = [1], [0, 1]
    while q:
        if q & 1:
            a = divide(multiply(a, b, p), modulus, p)[1]
        b = divide(multiply(b, b, p), modulus, p)[1]
        q //= 2
    a += [0] * max(0, 2 - len(a))
    a[1] -= 1
    return trim(a, p)


def check():
    if not __debug__:
        raise RuntimeError('Enabled assertions required for the referee audit')
    norms = {name: resultant(F, g) for name, g in {
        'beta': BETA, 't_minus_one': [-1, 1],
        'one_minus_t': [1, -1], 'three': [3], 'f': F}.items()}
    assert norms == {'beta': -27, 't_minus_one': 7,
                     'one_minus_t': 7, 'three': 729, 'f': 0}
    # Rabin irreducibility criterion for degree six, without divisor search.
    for d in (2, 3):
        assert gcd(F, frobenius_minus_x(2 ** d, F, 2), 2) == [1]
    assert frobenius_minus_x(64, F, 2) == []
    derivative = [i * F[i] for i in range(1, len(F))]
    common = gcd(F, trim(derivative, 3), 3)
    radical, remainder = divide(F, common, 3)
    assert not remainder and len(radical) == 4
    assert multiply(radical, radical, 3) == trim(F, 3)
    assert gcd(radical, frobenius_minus_x(3, radical, 3), 3) == [1]
    # Degree-six squarefree polynomial with all factors dividing X^125-X,
    # and no degree-one or degree-two factors, consists of two cubics.
    assert gcd(F, trim(derivative, 5), 5) == [1]
    for d in (1, 2):
        assert gcd(F, frobenius_minus_x(5 ** d, F, 5), 5) == [1]
    assert frobenius_minus_x(125, F, 5) == []
    seventh = [1]
    for _ in range(6):
        seventh = multiply(seventh, [-1, 1], 7)
    assert seventh == trim(F, 7)
    primes = [n for n in range(2, 27)
              if all(n % d for d in range(2, n))]
    assert primes == [2, 3, 5, 7, 11, 13, 17, 19, 23]
    for p in primes[4:]:
        assert gcd(F, frobenius_minus_x(p, F, p), p) == [1]
    # Abstract projective group consequence of accepted residue-unit images.
    polarized = [{(a + 4 * j) % 28 for j in range(7)} for a in range(4)]
    underlying = [{(a + 2 * j) % 28 for j in range(14)} for a in range(2)]
    assert len(set.union(*polarized)) == 28
    assert all(sum(o <= u for o in polarized) == 2 for u in underlying)
    return {'status': 'PASS', 'norm_method': 'Sylvester resultant with integer Bareiss determinant',
            'splitting_method': 'Frobenius polynomial gcd; no producer factor search',
            'norms': norms, 'primes_exhausted_below27': primes,
            'residue_degrees': {'2': [6], '3': [3], '5': [3, 3], '7': [1]},
            'ramification_indices': {'2': [1], '3': [2], '5': [1, 1], '7': [6]},
            'other_primes_have_no_degree_one_factor': primes[4:],
            'only_prime_ideal_norm_below27': 7,
            'unique_prime_above3_norm': 27,
            'polarized_projective_orbit_sizes': [len(o) for o in polarized],
            'underlying_projective_orbit_sizes': [len(o) for o in underlying],
            'scope': 'Finite arithmetic and abstract cyclic orbit consequence only; accepted monogeneity and unit-image premises remain required. No enumeration of all maximal isotropics.'}


if __name__ == '__main__':
    print(json.dumps(check(), indent=2, sort_keys=True))
