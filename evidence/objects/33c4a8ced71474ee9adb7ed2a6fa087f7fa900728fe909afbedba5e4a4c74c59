#!/usr/bin/env python3
"""Prepare/verify an allowlisted immutable-release candidate; never run it.

No math module is imported, no cloud API is used, and no Git metadata or local
environment is copied. Registration is captured with a stub executor only.
The recipient creates a fresh isolated Git commit before verify_release.py.
"""
from __future__ import annotations
import argparse
import ast
from contextlib import redirect_stdout
import gzip
from hashlib import sha256
import io
import json
from pathlib import Path
import re
import runpy
import stat
import subprocess
import sys
import tarfile
import types
from unittest.mock import patch

ROOT=Path(__file__).resolve().parents[3]
MANIFEST='release-bundle-manifest.json'
ROOT_FILES={'.gitignore','AGENTS.md','CODEX_START_HERE.md','README.md',
            'requirements.txt','verify_all.sh'}
TREES={'certificates':{'.py','.json','.jsonl','.md','.diff'},
       'independent':{'.py','.js','.md'}, 'docs':{'.md'},
       'scripts':{'.py','.sh'}, 'tests':{'.py'}, 'codex':{'.md'}}
EXACT={'paper/main.tex','dashboard/index.html','logs/RESEARCH_LOG.md',
       'logs/last_certificate_run.txt',
       'experiments/packet_scope/trace_coverage_v58.json',
       'experiments/broader_geometry_v67/run_pilot.py',
       'experiments/broader_geometry_v71/run_pilot.py',
       'experiments/broader_geometry_v71/compare.py',
       'experiments/continuous_v81/runner.py','experiments/continuous_v81/child.py',
       'experiments/continuous_v81/cloud/requirements.lock',
       'experiments/continuous_v81/cloud/release_bundle.py',
       'experiments/continuous_v81/cloud/legacy_math.py',
       'experiments/continuous_v81/cloud/test_legacy_math.py',
       'experiments/continuous_v81/cloud/prepare_node.py',
       'experiments/continuous_v81/cloud/guard_composite.py'}


def encoded(value):
    return (json.dumps(value,sort_keys=True,indent=2)+'\n').encode()


def digest(data):
    return sha256(data).hexdigest()


def names(root):
    answer=ROOT_FILES|EXACT
    for name,suffixes in TREES.items():
        for path in (root/name).rglob('*'):
            relative=path.relative_to(root)
            if any(part.startswith('.') or part=='__pycache__' for part in relative.parts):continue
            if path.is_file() and path.suffix in suffixes:answer.add(relative.as_posix())
    return sorted(answer)


def allowed(root,relative):
    path=Path(relative)
    if path.is_absolute() or '..' in path.parts:return False
    if relative in ROOT_FILES|EXACT:return True
    return (len(path.parts)>1 and path.parts[0] in TREES and
            path.suffix in TREES[path.parts[0]] and
            not any(part.startswith('.') or part=='__pycache__' for part in path.parts))


def contents(root):
    result={}
    for name in names(root):
        if not allowed(root,name):raise ValueError('Not allowlisted: '+name)
        path=root/name
        if (not path.is_file() or path.is_symlink() or
            not path.resolve().is_relative_to(root.resolve()) or
            any((root/Path(*Path(name).parts[:i])).is_symlink()
                for i in range(1,len(Path(name).parts)))):
            raise ValueError('Not an in-tree regular file: '+name)
        data=path.read_bytes()
        if re.search(rb'-----BEGIN (?:OPENSSH |RSA |EC |DSA )?PRIVATE KEY-----',data):
            raise ValueError('Private-key marker in allowlisted file: '+name)
        result[name]=(data,0o755 if path.stat().st_mode&0o111 else 0o644)
    return result


def capture_registration(root):
    captured=[]
    executor=types.ModuleType('certificate_execution')
    def capture(tasks,workers,source,output):
        assert Path(source)==root and workers==4
        captured.extend(tasks)
        return []
    executor.execute_tasks=capture
    with patch.dict(sys.modules,{'certificate_execution':executor}), \
         patch('shutil.which',return_value='/release-fixture/node'), \
         patch.dict('os.environ',{'CERT_WORKERS':'4'}),redirect_stdout(io.StringIO()):
        runpy.run_path(str(root/'scripts/run_certificates.py'))
    tasks=[]
    for label,command in captured:
        engine='node' if command[0]=='/release-fixture/node' else 'python'
        relative=Path(command[1]).relative_to(root).as_posix()
        tasks.append({'index':len(tasks)+1,'label':label,
                      'command':[engine,relative,*command[2:]]})
    assert len(tasks)==159 and len({row['label'] for row in tasks})==159
    assert sum(row['command'][0]=='python' for row in tasks)==157
    assert sum(row['command'][0]=='node' for row in tasks)==2
    return tasks


def static_checks(root,files,tasks):
    paths=set(files)
    for row in tasks:assert row['command'][1] in paths,row
    tex=files['paper/main.tex'][0].decode()
    advertised=re.findall(r'\\path\{([^}]+)\}',tex)
    assert all(name in paths for name in advertised)
    checked_pins={}
    for name,(data,mode) in files.items():
        if not name.startswith(('certificates/','independent/')) or not name.endswith('.py'):continue
        tree=ast.parse(data)
        for node in ast.walk(tree):
            if not isinstance(node,ast.Dict):continue
            for key,value in zip(node.keys,node.values):
                if not (isinstance(key,ast.Constant) and isinstance(key.value,str) and
                        isinstance(value,ast.Constant) and isinstance(value.value,str)):continue
                if key.value.startswith(('certificates/','independent/','experiments/')) and re.fullmatch('[0-9a-f]{64}',value.value):
                    assert key.value in paths,('missing pin',name,key.value)
                    assert digest(files[key.value][0])==value.value,('changed pin',name,key.value)
                    checked_pins[key.value]=value.value
    return {'registered_commands':len(tasks),'python_commands':157,'node_commands':2,
            'registered_sage_or_magma_commands':0,'manuscript_path_references':len(advertised),
            'literal_pinned_dependencies_checked':checked_pins,
            'scope':'STATIC_SOURCE_AND_CAPTURED_REGISTRATION_ONLY_NO_MATH_IMPORTS'}


def inventory(root):
    files=contents(root)
    tasks=capture_registration(root)
    checks=static_checks(root,files,tasks)
    commit=subprocess.check_output(['git','-C',str(root),'rev-parse','HEAD'],text=True).strip()
    record={'schema_version':1,'scope':'ALLOWLISTED_159_COMMAND_RELEASE_CANDIDATE_NOT_EXECUTED',
            'origin_parent_commit':commit,'origin_is_dirty_working_source_snapshot':True,
            'requires_new_isolated_git_commit':True,'registered_commands':tasks,
            'files':{name:{'sha256':digest(data),'bytes':len(data),'mode':mode}
                     for name,(data,mode) in files.items()},'checks':checks,
            'exclusions':['original .git','.codex','.aws','.agents','credentials','build',
                          'local runtimes','private files','old PDFs','unneeded experiments'],
            'runtime_requirements':{'python':'3.14.x recommended to match cloud campaign; record actual binary',
                'sympy':'1.14.0','mpmath':'1.3.0','node':'required; record version/binary; no npm modules',
                'system':['bash','git','LaTeX engine and manuscript packages'],
                'sage':'not registered; no baseline Sage command omitted'},
            'execution_policy':{'start_automatically':False,'maximum_registered_workers':4,
                'common_per_job_cpu_limit':None,'common_per_job_wall_limit':None,
                'math_only_wrapper':'experiments/continuous_v81/cloud/legacy_math.py',
                'math_only_scope':'Exact existing159 argv only; separate reviewed adaptive4-to26 executor; not full verify_all or source/PDF release',
                'adaptive_math_workers':{'initial':4,'after_v82_terminal_and_process_absence':26,
                    'v82_concurrent_workers_max':24,'math_child_as_mib':2048,'post_v82_admin_as_mib':4096},
                'full_run_command':['python','scripts/verify_release.py','--output-dir','NEW_EVIDENCE_DIR'],
                'preflight_command':['python','scripts/verify_release.py','--output-dir','NEW_PREFLIGHT_DIR','--preflight-only']}}
    return files,record


def verify(root):
    record=json.loads((root/MANIFEST).read_text())
    assert record['scope']=='ALLOWLISTED_159_COMMAND_RELEASE_CANDIDATE_NOT_EXECUTED'
    for name,info in record['files'].items():
        assert allowed(root,name),name
        path=root/name
        assert path.is_file() and not path.is_symlink() and path.resolve().is_relative_to(root.resolve()),name
        assert len(path.read_bytes())==info['bytes'] and digest(path.read_bytes())==info['sha256'],name
        assert (0o755 if path.stat().st_mode&0o111 else 0o644)==info['mode'],name
    expected=set(record['files'])|{MANIFEST}
    actual={path.relative_to(root).as_posix() for path in root.rglob('*') if path.is_file()}
    assert actual==expected,{'missing':sorted(expected-actual),'extra':sorted(actual-expected)}
    tasks=capture_registration(root)
    assert tasks==record['registered_commands']
    check=static_checks(root,contents(root),tasks)
    assert check==record['checks']
    return {'status':'SOURCE_PAYLOAD_VERIFIED_NO_RELEASE_EXECUTED','files':len(record['files']),
            'manifest_sha256':digest((root/MANIFEST).read_bytes()),'registered_commands':len(tasks)}


def main():
    parser=argparse.ArgumentParser(description=__doc__)
    action=parser.add_mutually_exclusive_group(required=True)
    action.add_argument('--inventory',type=Path)
    action.add_argument('--output',type=Path,help='New directory for source snapshot, tar.gz and manifest')
    action.add_argument('--verify',type=Path,help='Fresh extracted source directory before Git initialization')
    args=parser.parse_args()
    if args.verify:
        print(json.dumps(verify(args.verify.resolve()),sort_keys=True));return
    files,record=inventory(ROOT)
    if args.inventory:
        args.inventory.parent.mkdir(parents=True,exist_ok=True)
        with args.inventory.open('xb') as stream:stream.write(encoded(record))
        print(json.dumps({'status':'INVENTORY_ONLY','files':len(files),
            'source_bytes':sum(len(data) for data,mode in files.values()),'commands':159}));return
    output=args.output.resolve();output.mkdir(parents=True,exist_ok=False)
    source=output/'source';source.mkdir()
    manifest=encoded(record)
    payload={**files,MANIFEST:(manifest,0o644)}
    for name,(data,mode) in payload.items():
        path=source/name;path.parent.mkdir(parents=True,exist_ok=True)
        with path.open('xb') as stream:stream.write(data)
        path.chmod(mode)
    verified=verify(source)
    archive=output/'release-source.tar.gz'
    with archive.open('xb') as raw:
        with gzip.GzipFile(filename='',mode='wb',fileobj=raw,mtime=0) as compressed:
            with tarfile.open(mode='w',fileobj=compressed,format=tarfile.PAX_FORMAT) as tar:
                for name,(data,mode) in sorted(payload.items()):
                    info=tarfile.TarInfo(name);info.size=len(data);info.mode=mode
                    info.mtime=0;info.uid=info.gid=0;info.uname=info.gname=''
                    tar.addfile(info,io.BytesIO(data))
    after=contents(ROOT)
    if after!=files:raise RuntimeError('Source changed during packaging; retained candidate is invalid')
    summary={**verified,'status':'RELEASE_CANDIDATE_BUNDLED_NOT_RUN','archive':str(archive),
        'archive_bytes':archive.stat().st_size,'archive_sha256':digest(archive.read_bytes()),
        'source_bytes':sum(len(data) for data,mode in files.values()),'original_sources_unchanged':True}
    with (output/'bundle.json').open('xb') as stream:stream.write(encoded(summary))
    print(json.dumps(summary,sort_keys=True))


if __name__=='__main__':main()
