"""Independent targeted C86 trace-pairing audit; no all-subspace loop.

Reuses only the referee's F27 arithmetic from C85, not either producer.
In K=k[s]/(s^2+1), Tr_K/F3(s*x*bar(y))=2 Tr_k/F3(det(x,y)).
Global mixed integrality, positivity and minimum classification are human.
"""
import importlib.util
import itertools
import json
from pathlib import Path

source = Path(__file__).resolve().parents[1] / 'fermat_unpolarized_quotients_v156/referee_residue01.py'
spec = importlib.util.spec_from_file_location('referee_f27', source)
field = importlib.util.module_from_spec(spec)
spec.loader.exec_module(field)


def kpow(x, n):
    y = 1
    for _ in range(n):
        y = field.mul(y, x)
    return y


def trace(x):
    answer = field.add(field.add(x, kpow(x, 3)), kpow(x, 9))
    assert answer in (0, 1, 2)
    return answer


def pair(c, x, y):
    determinant = field.add(field.mul(x[0], y[1]), field.neg(field.mul(x[1], y[0])))
    return 2 * trace(field.mul(c, determinant)) % 3


def det3(m):
    a, b, c = m
    return (a[0]*(b[1]*c[2]-b[2]*c[1])
            -a[1]*(b[0]*c[2]-b[2]*c[0])
            +a[2]*(b[0]*c[1]-b[1]*c[0])) % 3


def check():
    if not __debug__:
        raise RuntimeError('Enabled assertions required')
    basis = [1, 3, 9]
    # Each nonzero trace coefficient gives a nonsingular trace matrix;
    # the associated six-dimensional alternating block matrix is nonsingular.
    determinants = [det3([[trace(field.mul(c, field.mul(x, y))) for y in basis]
                         for x in basis]) for c in range(1, 27)]
    assert all(determinants)
    examples = {
        'k_line': [(1, 0), (3, 0), (9, 0)],
        'non_k_principalizable': [(1, 0), (3, 1), (9, 3)],
        'obstructed': [(1, 0), (3, 1), (9, 9)],
    }
    results = {}
    for name, h in examples.items():
        # Their real components are the basis of k, hence all are F3-rank3.
        assert [v[0] for v in h] == basis
        annihilator = [c for c in range(27)
                       if all(pair(c, h[i], h[j]) == 0 for i, j in [(0, 1), (0, 2), (1, 2)])]
        cardinality = len(annihilator)
        assert cardinality in (1, 3, 27)
        dimension = {1: 0, 3: 1, 27: 3}[cardinality]
        constraints = [[pair(c, h[i], h[j]) for c in basis]
                       for i, j in [(0, 1), (0, 2), (1, 2)]]
        results[name] = {'basis': h, 'T_dimension': dimension,
                         'T_elements': annihilator, 'coefficient_constraints': constraints}
    assert [results[k]['T_dimension'] for k in examples] == [3, 1, 0]
    assert det3(results['obstructed']['coefficient_constraints']) != 0
    h = examples['obstructed']
    for c in range(1, 27):
        entries = [pair(c, h[i], h[j]) for i, j in [(0, 1), (0, 2), (1, 2)]]
        assert any(entries)
        a, b, d = entries
        assert det3([[0, a, b], [-a % 3, 0, d], [-b % 3, -d % 3, 0]]) == 0
        # Any nonzero off-diagonal entry gives an invertible2x2 minor.
        assert any(x*x % 3 for x in entries)
    squares = {field.mul(a, a) for a in range(1, 27)}
    assert len(squares) == 13 and 2 not in squares
    assert all(sum(x in squares for x in (a, field.neg(a))) == 1 for a in range(1, 27))
    norm_image_order = 364 // 28  # gcd(364,28)=28.
    assert norm_image_order == 13
    positive_min_norm, degree = 27 * 27, (27 * 27) ** 2
    assert positive_min_norm == 3 ** 6 and degree == 3 ** 12 == 531441
    # Rank2 modulo3 means one exponent0. The determinant fixes their sum6.
    exponent_solutions = [a for a in itertools.combinations_with_replacement(range(7), 6)
                          if sum(a) == 6 and a.count(0) == 1]
    assert exponent_solutions == [(0, 1, 1, 1, 1, 2)]
    return {'status': 'PASS', 'model': 'F27 cubic; trace determinant form on F27^2',
            'producer_imports': False, 'all_subspaces_enumerated': False,
            'nonzero_coefficients_nondegenerate': 26, 'explicit_examples': results,
            'obstructed_restriction_rank_for_every_nonzero_coefficient': 2,
            'positive_unit_residue_image_order_from_accepted_U': norm_image_order,
            'one_square_in_each_nonzero_sign_pair': True,
            'structural_incidence_counts': {'0': 33880-28-13*(1120-28), '1': 13*(1120-28), '3': 28},
            'minimum_degree_arithmetic': degree,
            'unique_type_from_degree_and_mod3_rank': [3**a for a in exponent_solutions[0]],
            'minimum_class_index_arithmetic': 13*2,
            'scope': 'Targeted field-pairing witnesses and exact arithmetic consequences. Actual integrality, unit lifting, signed norm bound and classification remain human proofs.'}


if __name__ == '__main__':
    print(json.dumps(check(), indent=2, sort_keys=True))
