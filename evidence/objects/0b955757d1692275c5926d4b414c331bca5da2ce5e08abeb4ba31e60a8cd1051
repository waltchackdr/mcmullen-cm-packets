"""Regress the finite part of C90; the geometric proof is a separate input."""
import json,subprocess,sys,unittest
from pathlib import Path
ROOT=Path(__file__).resolve().parents[1]

class GaloisFiniteRegression(unittest.TestCase):
    def test_actual_catalog_partition(self):
        path=ROOT/'experiments/s_order_galois_v163/finite_action_candidate.py'
        # The producer owns CPU/alarm limits; isolate them from other tests.
        result=subprocess.run([sys.executable,str(path)],capture_output=True,text=True,
                              check=True,timeout=30)
        actual=json.loads(result.stdout)
        expected=json.loads((ROOT/'experiments/s_order_galois_v163/finite_action01.json').read_text())
        # Runtime metadata is not mathematical certificate output.
        actual.pop('wall_seconds');expected.pop('wall_seconds')
        self.assertEqual(actual,expected)
        summary=actual['summary']['full_semilinear_similitude_candidate']
        self.assertEqual(summary['permutation_group_order'],24)
        self.assertEqual(summary['S_representatives'],[0,1,2,3,6,12,15,17,40,91])
        self.assertEqual(sorted(summary['S_sizes']),[4,8,12,12,12,12,24,24,24,24])

if __name__=='__main__':unittest.main()
