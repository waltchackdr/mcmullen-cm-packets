"""Exact finite regression model for the separate C84 human proof.

Use sum-zero vectors in F3^7, cyclic shift and the alternating cycle form.
No theorem promotion or identification with actual CM homology by this loop.
"""
from itertools import combinations, product
import json
import resource
import signal


def rref(rows):
    rows = [list(x) for x in rows]
    r = 0
    for j in range(6):
        i = next((i for i in range(r, len(rows)) if rows[i][j] % 3), None)
        if i is None:
            continue
        rows[r], rows[i] = rows[i], rows[r]
        rows[r] = [x * pow(rows[r][j] % 3, -1, 3) % 3 for x in rows[r]]
        for i in range(len(rows)):
            if i != r:
                a = rows[i][j] % 3
                rows[i] = [(x - a * y) % 3 for x, y in zip(rows[i], rows[r])]
        r += 1
        if r == len(rows):
            break
    return tuple(tuple(x) for x in rows[:r])


def lift(v):
    return tuple(v) + ((-sum(v)) % 3,)


def shift(v):
    w = lift(v)
    return (w[-1],) + w[:5]


def shift_inverse(v):
    return lift(v)[1:]


def real_action(v):
    return tuple((x + y) % 3 for x, y in zip(shift(v), shift_inverse(v)))


def pair(v, w):
    v, w = lift(v), lift(w)
    return sum(v[i] * (w[(i+1) % 7] - w[(i-1) % 7]) for i in range(7)) % 3


def check():
    if not __debug__:
        raise RuntimeError("Enabled assertions required")
    basis = [tuple(int(i == j) for i in range(6)) for j in range(6)]
    gram = [[pair(v, w) for w in basis] for v in basis]
    assert len(rref(gram)) == 6
    assert all(pair(shift(v), shift(w)) == pair(v, w) for v in basis for w in basis)
    total, lagrangians = 0, set()
    for pivots in combinations(range(6), 3):
        free = [(i, j) for i, p in enumerate(pivots)
                for j in range(p+1, 6) if j not in pivots]
        for values in product(range(3), repeat=len(free)):
            rows = [[int(j == p) for j in range(6)] for p in pivots]
            for (i, j), value in zip(free, values):
                rows[i][j] = value
            total += 1
            if all(pair(rows[i], rows[j]) == 0 for i in range(3) for j in range(i)):
                lagrangians.add(tuple(tuple(row) for row in rows))
    assert total == 33880 and len(lagrangians) == 1120
    stable = {h for h in lagrangians if rref(h + tuple(real_action(v) for v in h)) == h}
    assert len(stable) == 28
    left, orbits = set(lagrangians), []
    while left:
        h = min(left)
        orbit, w = set(), h
        for _ in range(7):
            orbit.add(w)
            w = rref([shift(v) for v in w])
        assert w == h and len(orbit) == 7 and orbit <= left
        left -= orbit
        orbits.append(orbit)
    assert len(orbits) == 160
    assert sum(o <= stable for o in orbits) == 4
    assert sum(not (o & stable) for o in orbits) == 156
    return {'status': 'EXACT_FINITE_SYMPLECTIC_MODEL_PASS',
        'model': 'Sum-zero F3^7; cyclic shift; alternating nearest-neighbor cycle form',
        'gram': gram, 'all_dimension3_subspaces': total,
        'lagrangian_count': len(lagrangians), 'real_subfield_stable_count': len(stable),
        'order7_orbit_count': len(orbits), 'orbit_sizes': [7],
        'real_stable_orbits': 4, 'other_orbits': 156,
        'negative_control': '1092 maximal isotropics are not stable under T+T^-1',
        'scope': 'Finite cyclic symplectic model; actual module identification and quotient theorem require the separate human proof.'}


if __name__ == '__main__':
    resource.setrlimit(resource.RLIMIT_CPU, (20, 20))
    signal.alarm(30)
    print(json.dumps(check(), indent=2, sort_keys=True))
