                     else (*range(16), *range(32, 48)))
            labels.update(f'{stratum}:pic{picard}:{mask:02d}' for mask in masks)
    require(len(labels) == 368 and set(HITS) <= labels, 'Internal C39 declaration')
    return sorted(labels - set(HITS))


