class Anomaly(ValueError):
    pass


def require(condition, message):
    if not condition:
        raise Anomaly(message)


def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode()


def object_hash(value):
    return hashlib.sha256(canonical(value)).hexdigest()


def duplicate_free(items):
    result = {}
    for key, value in items:
        require(key not in result, 'Duplicate JSON key: ' + key)
        result[key] = value
    return result


def read(path):
    with Path(path).open() as stream:
        return json.load(stream, object_pairs_hook=duplicate_free,
                         parse_constant=lambda x: (_ for _ in ()).throw(Anomaly('Nonfinite JSON: ' + x)))


def sha(path):
    h = hashlib.sha256()
    with Path(path).open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            h.update(block)
    return h.hexdigest()


def safe(path):
    """Reject links in every component, including ancestors of the campaign."""
    path = Path(os.path.abspath(path))
    for component in (path, *path.parents):
        require(not component.is_symlink(), 'Symlink evidence path: ' + str(component))
    return path


def below(root, relative):
    require(type(relative) is str and relative and '\\' not in relative,
            'Malformed evidence relative path')
    require(not relative.startswith('/') and all(p not in ('', '.', '..') for p in relative.split('/')),
            'Unsafe evidence relative path: ' + relative)
    return safe(root / relative)


def signature(path):
    info = safe(path).stat()
    require(stat.S_ISREG(info.st_mode), 'Nonregular evidence file: ' + str(path))
    require(info.st_nlink == 1, 'Hard-linked evidence file: ' + str(path))
    return (info.st_dev, info.st_ino, info.st_size, info.st_mtime_ns, info.st_ctime_ns)


def inventory(root):
    result = {}; inodes = set()
    for current, directories, files in os.walk(safe(root), followlinks=False):
        for name in directories:
            path = safe(Path(current) / name)
            require(path.is_dir(), 'Non-directory evidence component')
        for name in files:
            path = safe(Path(current) / name)
            sig = signature(path)
            require(sig[:2] not in inodes, 'Duplicate evidence inode alias')
            inodes.add(sig[:2]); result[path.relative_to(root).as_posix()] = sig
    return result


class Hashes:
    """Cache bytes only while the complete stat identity is unchanged.

    The campaign is quiescent under its coordinator lock. This avoids repeated
    multi-GB reads by overlapping frozen validators. It is not a defense against
    a privileged adversary forging kernel stat metadata.
    """
    def __init__(self):
        self.rows = {}
        self.bytes_hashed = 0

    def __call__(self, path):
        path = safe(path)
        before = signature(path)
        if path in self.rows:
            old, checksum = self.rows[path]
            require(old == before, 'Evidence changed during audit: ' + str(path))
            return checksum
        checksum = sha(path)
        require(signature(path) == before, 'Evidence changed while hashing: ' + str(path))
        self.rows[path] = (before, checksum)
        self.bytes_hashed += before[2]
        return checksum

    def unchanged(self):
        for path, (old, _) in self.rows.items():
            require(signature(path) == old, 'Evidence changed after validation: ' + str(path))


def save(output, name, value):
    path = below(output, name)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open('xb') as stream:
        stream.write(canonical(value)); stream.flush(); os.fsync(stream.fileno())
    return sha(path)


def declared_domain():
    labels = set()
    for stratum in ('OM', 'R7', 'R7sq', 'R41_12', 'R41_22', 'R43_20', 'R43_31', 'R83', 'R127'):
        for picard in ((0, 1) if stratum in ('R83', 'R127') else (0,)):
            masks = (range(16) if stratum == 'OM' else range(64) if (stratum, picard) == ('R127', 1)
