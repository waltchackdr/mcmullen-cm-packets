import hashlib
import importlib.util
import json
from pathlib import Path
import resource
import signal
import tempfile
import time
import unittest

resource.setrlimit(resource.RLIMIT_CPU, (20, 20))
signal.alarm(30)
ROOT = Path(__file__).resolve().parents[1]
spec = importlib.util.spec_from_file_location('retention',
    ROOT/'experiments/bc_jacobian_v147/runtime/retain_candidate.py')
retention = importlib.util.module_from_spec(spec)
spec.loader.exec_module(retention)


class RetentionTests(unittest.TestCase):
    def snapshot(self, raw):
        pin = hashlib.sha256(raw).hexdigest()
        return {'artifacts':{'pipeline.json':{'sha256':pin,'bytes':len(raw)}},
                'missing':['setup/runtime.json'], 'rejected':[]}

    def run_retention(self, root, raw, fetch=None, deadline=None):
        snapshot = self.snapshot(raw)
        return retention.retain(snapshot, {'pipeline.json','setup/runtime.json'}, root,
            fetch or (lambda h,o,n,t:raw[o:o+n]),
            time.monotonic()+5 if deadline is None else deadline)

    def test_raw_and_missing_preserved(self):
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp); raw=b'{"untouched":  1}\n'
            result=self.run_retention(root, raw)
            receipt=json.loads(Path(result['receipt']).read_text())
            self.assertEqual(receipt['missing'], ['setup/runtime.json'])
            self.assertIsNone(receipt['mathematical_conclusion'])
            self.assertEqual(next((root/'blobs').iterdir()).read_bytes(), raw)

    def test_changed_versions_both_retained(self):
        with tempfile.TemporaryDirectory() as tmp:
            root=Path(tmp)
            self.run_retention(root,b'partial')
            self.run_retention(root,b'complete')
            self.assertEqual(len(list((root/'blobs').iterdir())),2)
            self.assertEqual(len(list(root.glob('snapshot-*.json'))),2)

    def test_cached_blob_reused_without_network(self):
        with tempfile.TemporaryDirectory() as tmp:
            self.run_retention(tmp,b'raw')
            def fetch(*args):raise AssertionError('Repeated download')
            self.run_retention(tmp,b'raw',fetch=fetch)

    def test_truncated_or_wrong_bytes_rejected(self):
        for bad in (b'x',b'bad'):
            with self.subTest(bad=bad), tempfile.TemporaryDirectory() as tmp:
                with self.assertRaises(ValueError):
                    self.run_retention(tmp,b'raw',fetch=lambda *args:bad)
                self.assertEqual(list(Path(tmp).glob('snapshot-*.json')),[])
                self.assertEqual(list((Path(tmp)/'blobs').iterdir()),[])

    def test_unlisted_path_rejected_before_fetch(self):
        snapshot=self.snapshot(b'raw')
        snapshot['artifacts']['../escape']=snapshot['artifacts'].pop('pipeline.json')
        with tempfile.TemporaryDirectory() as tmp, self.assertRaises(ValueError):
            retention.retain(snapshot, {'pipeline.json','setup/runtime.json'}, tmp,
                lambda *args:self.fail('Fetch before validation'), time.monotonic()+5)

    def test_expired_deadline(self):
        with tempfile.TemporaryDirectory() as tmp, self.assertRaises(ValueError):
            self.run_retention(tmp,b'raw',deadline=time.monotonic()-1,
                               fetch=lambda *args:self.fail('Late fetch'))

    def test_corrupt_cache_rejected(self):
        with tempfile.TemporaryDirectory() as tmp:
            self.run_retention(tmp,b'raw')
            next((Path(tmp)/'blobs').iterdir()).write_bytes(b'bad')
            with self.assertRaises(ValueError):self.run_retention(tmp,b'raw')


if __name__ == '__main__':unittest.main()
