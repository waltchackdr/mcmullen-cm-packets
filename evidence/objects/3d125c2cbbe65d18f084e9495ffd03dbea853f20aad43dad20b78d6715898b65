def reference(a,record,expected=None):
 need(type(record)is dict and set(record)=={'path','sha256'} and Path(record['path']).is_absolute(),'Exact absolute reference')
 path=a.safe(record['path']);a.signature(path)
 need(sha(path)==record['sha256'] and (expected is None or record['sha256']==expected),'Reference seal mismatch')
 return path,a.read(path)


class Store:
 """Immutable, exhaustive retained bytes; zero authority from the local path."""
 def __init__(self,a,root,coordinate,inventory,allow_extras=False):
  self.a=a;self.root=a.safe(root);self.coordinate=Path(coordinate)
  need(self.root.is_absolute() and self.root.is_dir() and self.coordinate.is_absolute(),'Absolute evidence roots')
  self.before=a.inventory(self.root);self.directories=self.directory_snapshot();self.cache=a.Hashes();self.files=inventory['files'];self.json_cache={}
  need(type(inventory['schema_version'])is int and inventory['schema_version']==1,'Inventory schema')
  need(type(self.files)is dict and set(self.files)<=set(self.before),'Missing inventory files')
  wanted_directories=inventory['directories']
  need(type(wanted_directories)is list and wanted_directories==sorted(set(wanted_directories)), 'Captured directory names')
  actual_directories=set(self.directories)-{'.'}
  need(set(wanted_directories)<=actual_directories,'Missing captured directory')
  self.extra_directories=sorted(actual_directories-set(wanted_directories))
  need(allow_extras or not self.extra_directories,'Unrecorded continuation directories')
  self.extras=sorted(set(self.before)-set(self.files)-{'coordinator.lock'})
  need(allow_extras or not self.extras,'Unrecorded continuation files')
  for name,row in self.files.items():
   p=self.path(name)
   need(type(row)is dict and set(row)=={'bytes','sha256'},'Inventory row schema')
   need(type(row['bytes'])is int and row['bytes']>=0 and p.stat().st_size==row['bytes'] and self.cache(p)==row['sha256'],'Captured bytes changed: '+name)
  # Retain prior-transfer extras as extras, never substitute them for indexed files.
  self.extra_seals={n:{'bytes':self.before[n][2],'sha256':self.cache(self.root/n)} for n in self.extras}
 def directory_snapshot(self):
  result={}
  def fail(error):raise error
  for folder,dirs,files in os.walk(self.root,followlinks=False,onerror=fail):
   p=self.a.safe(folder);st=p.stat();result[p.relative_to(self.root).as_posix()]=(st.st_dev,st.st_ino,st.st_mtime_ns,st.st_ctime_ns)
  return result
 def path(self,name):
  need(name in self.files,'Read outside captured file inventory: '+name);return self.a.below(self.root,name)
 def mapped(self,path):
  path=Path(path)
  if path.is_relative_to(self.root):relative=path.relative_to(self.root)
  else:
   need(path.is_relative_to(self.coordinate),'Unmapped evidence coordinate');relative=path.relative_to(self.coordinate)
  # Directory mapping permits the frozen validators to derive descendant names.
  result=self.a.below(self.root,relative.as_posix()) if relative.parts else self.root
  if result.is_file():need(relative.as_posix() in self.files,'Read outside captured file inventory')
  return result
 def sha(self,name):return self.cache(self.path(name))
 def read(self,name):
  self.sha(name)
  cacheable=name in ('state.json','manifest.json') or name.startswith('plans/')
  if cacheable and name in self.json_cache:return self.json_cache[name]
  result=self.a.read(self.path(name))
  if cacheable:self.json_cache[name]=result
  return result
 def unchanged(self):
  self.cache.unchanged();need(self.a.inventory(self.root)==self.before and self.directory_snapshot()==self.directories,'Captured inventory mutated during audit')


def mapped_runner(a,store):
 """Only file adapters differ; argv, result and journal algorithms stay frozen."""
 p=store.path('source/'+HERE+'/runner.py')
 r=load(p,PINS[HERE+'/runner.py'],'cross_runner_'+str(id(store)))
 original_pins=r.driver_pins
 r.read=lambda p:store.read(store.mapped(p).relative_to(store.root).as_posix())
 r.digest=lambda p:store.cache(store.mapped(p))
 r.contained=lambda root,name:store.mapped(a.below(Path(root),name))
 r.driver_pins=lambda p:original_pins(store.mapped(p))
 return r


