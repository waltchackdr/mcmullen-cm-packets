def overlap(rows,capacity):
 events=[]
 for row in rows:
  if row['status']!='NEVER_STARTED':events.extend(((row['started_epoch'],1),(row['finished_epoch'],-1)))
 active=peak=0
 for _,delta in sorted(events):active+=delta;need(active>=0,'Invalid interval');peak=max(peak,active)
 need(active==0 and peak<=capacity,'Observed concurrency exceeds approved workers');return peak


