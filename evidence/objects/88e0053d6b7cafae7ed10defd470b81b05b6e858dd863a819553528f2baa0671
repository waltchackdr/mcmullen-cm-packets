"""Independent retained sparse12 data replay; no theta reevaluation."""
import importlib.util
from pathlib import Path
import unittest
ROOT=Path(__file__).resolve().parents[1]
SPEC=importlib.util.spec_from_file_location('theta_extension05',ROOT/'experiments/s_order_theta_v164/referee_actual_data05.py')
AUDIT=importlib.util.module_from_spec(SPEC);SPEC.loader.exec_module(AUDIT)
class SparseExtension(unittest.TestCase):
    def test_complete_sparse_extension(self):
        r=AUDIT.run()
        self.assertEqual(len(r['observations']),128)
        self.assertEqual(len(r['complete_tasks']),16)
        self.assertTrue(r['session_success'])
        self.assertTrue(r['prior_pairs_disjoint'])
        self.assertEqual(r['cumulative_nonzero_pairs'],{str(i):56 for i in (0,1,2,3,6,12,15,17,40,91)})
        self.assertTrue(all(o['nonzero'] and o['finite'] for o in r['observations']))
        self.assertEqual(len(r['negative_cases_rejected']),13)
if __name__=='__main__':unittest.main()
