def require(condition, message):
    if not condition:
        raise ValueError(message)


def valid_hash(value):
    return type(value) is str and re.fullmatch("[0-9a-f]{64}", value) is not None


def canonical(value):
    return (json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()


def sha(path):
    h = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def decode(raw):
    def pairs(items):
        result = {}
        for key, value in items:
            require(key not in result, "Duplicate JSON key")
            result[key] = value
        return result
    return json.loads(raw, object_pairs_hook=pairs,
                      parse_constant=lambda value: (_ for _ in ()).throw(ValueError(value)))


class Evidence:
    def __init__(self, root, references):
        self.root, self.references = root.resolve(), references
        self.objects, self.paths, self.hashes, self.signatures = {}, {}, {}, {}
        seen = {}
        for name, reference in references.items():
            if reference is None:
                continue
            require(type(reference) is dict and set(reference) == {"path", "sha256"}, "Reference schema: " + name)
            relative = reference["path"]
            require(type(relative) is str and relative and not relative.startswith("/") and
                    all(part not in ("", ".", "..") for part in relative.split("/")), "Unsafe evidence path")
            path = self.root / relative
            require(not any(p.is_symlink() for p in (path, *path.parents)), "Symlink evidence")
            require(path.is_file() and path.stat().st_nlink == 1, "Regular single-link evidence required")
            require(path.resolve().is_relative_to(self.root), "Evidence outside root")
            identity = (path.stat().st_dev, path.stat().st_ino)
            if identity in seen:
                prior=seen[identity]
                require({prior,name}=={'legacy_runtime','v82_runtime'} and reference['sha256']==self.hashes[prior],
                        'Unapproved aliased evidence references')
            else:seen[identity]=name
            raw = path.read_bytes()
            require(valid_hash(reference["sha256"]) and hashlib.sha256(raw).hexdigest() == reference["sha256"], "Evidence SHA mismatch: " + name)
            self.paths[name], self.hashes[name] = path, reference["sha256"]
            info=path.stat();self.signatures[name]=(info.st_dev,info.st_ino,info.st_size,info.st_mtime_ns,info.st_ctime_ns)
            self.objects[name] = raw if name in ('audit_stdout','audit_stderr')else decode(raw)

    def recheck(self):
        for name,path in self.paths.items():
            require(not any(p.is_symlink()for p in(path,*path.parents)) and path.is_file() and path.stat().st_nlink==1,
                    'Evidence became a link/nonregular file')
            info=path.stat()
            require((info.st_dev,info.st_ino,info.st_size,info.st_mtime_ns,info.st_ctime_ns)==self.signatures[name] and
                    sha(path)==self.hashes[name], 'Evidence changed during join')


