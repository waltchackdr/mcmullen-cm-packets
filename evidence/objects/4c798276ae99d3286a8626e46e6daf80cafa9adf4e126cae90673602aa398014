                record['all_eleven_captures_and_all_completed_duplicates_reviewed']is True,
                'Actual cross-cohort histories/duplicate/ordinary-source outcome review')
    require(type(record["retention_evidence_sha256"]) is dict and record["retention_evidence_sha256"] and
            all(valid_hash(v) for v in record["retention_evidence_sha256"].values()), "No archival evidence bindings")


