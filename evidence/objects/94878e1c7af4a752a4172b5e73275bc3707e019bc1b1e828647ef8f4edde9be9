"""Exercise real child limits and fail-closed source binding, without geometry."""
import importlib.util
import json
import os
from pathlib import Path
import signal
import sys
import tempfile
import unittest

ROOT = Path(__file__).resolve().parents[1]
SPEC = importlib.util.spec_from_file_location(
    "broader_pilot_runner", ROOT / "experiments/broader_geometry_v67/run_pilot.py")
runner = importlib.util.module_from_spec(SPEC)
SPEC.loader.exec_module(runner)


class BroaderPilotLimits(unittest.TestCase):
    def child(self, code, cpu=2, wall=5):
        with tempfile.TemporaryDirectory() as directory:
            path = Path(directory)
            rows = []
            result = runner.run_child([sys.executable, "-B", "-u", "-c", code],
                                      path, cpu, wall, rows.append)
            return result, (path / "child.log").read_text(), rows

    def test_child_inherits_hard_cpu_limit_and_writes_log(self):
        result, log, rows = self.child(
            "import json,resource;print(json.dumps(resource.getrlimit(resource.RLIMIT_CPU)))")
        self.assertEqual(json.loads(log), [2, 3])
        self.assertEqual(result["status"], "completed_discovery_only")
        self.assertEqual(rows[0]["status"], "running")

    def test_sleeping_child_is_killed_at_wall_deadline(self):
        result, _, _ = self.child("import time;time.sleep(30)", wall=0.15)
        self.assertEqual(result["status"], "incomplete_wall_limit")
        self.assertEqual(result["returncode"], -signal.SIGKILL)
        self.assertLess(result["wall_seconds"], 5)

    def test_busy_child_cannot_exceed_cpu_budget(self):
        result, _, _ = self.child("while True: pass", cpu=1, wall=5)
        self.assertEqual(result["status"], "incomplete_cpu_limit")
        self.assertEqual(result["returncode"], -signal.SIGXCPU)

    def test_changed_dependency_is_rejected_before_execution(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            here = root / runner.HERE
            here.mkdir(parents=True)
            dependency = root / "foundation.py"
            dependency.write_text("original\n")
            pins = {"foundation.py": runner.digest(dependency)}
            for backend in runner.BACKENDS:
                (here / f"{backend}.py").write_text(f"SOURCE_PINS = {pins!r}\n")
            (here / "run_pilot.py").write_text("# test fixture\n")
            runner.source_manifest(root)
            dependency.write_text("changed\n")
            with self.assertRaisesRegex(ValueError, "Changed pinned source"):
                runner.source_manifest(root)

    def test_existing_log_is_never_overwritten(self):
        with tempfile.TemporaryDirectory() as directory:
            output = Path(directory)
            log = output / "child.log"
            log.write_text("preserved evidence\n")
            with self.assertRaises(FileExistsError):
                runner.run_child([sys.executable, "-c", "raise Exception()"],
                                 output, 1, 2, lambda row: None)
            self.assertEqual(log.read_text(), "preserved evidence\n")

    def test_progress_write_failure_reaps_live_child(self):
        pids = []
        def failing_progress(row):
            pids.append(row["pid"])
            raise OSError("simulated disk failure")
        with tempfile.TemporaryDirectory() as directory:
            with self.assertRaisesRegex(OSError, "simulated disk failure"):
                runner.run_child([sys.executable, "-c", "import time;time.sleep(30)"],
                                 Path(directory), 2, 5, failing_progress)
            self.assertEqual(len(pids), 1)
            with self.assertRaises(ProcessLookupError):
                os.kill(pids[0], 0)


if __name__ == "__main__":
    unittest.main()
