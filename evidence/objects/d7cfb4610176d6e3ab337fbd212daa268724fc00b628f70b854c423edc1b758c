"""Full integral Hodge-endomorphism obstruction for the actual induced A model."""
import json
from pathlib import Path
import subprocess
import sys
import unittest
ROOT=Path(__file__).resolve().parents[1]
CERT=ROOT/'certificates/a_unmarked_polarization_v140.py'
class AUnmarkedPolarization(unittest.TestCase):
    def test_full_endomorphism_trace_ball(self):
        r=subprocess.run([sys.executable,'-B',str(CERT)],capture_output=True,text=True,timeout=25,check=True)
        self.assertEqual(json.loads(r.stdout),{'status':'A_FULL_ENDOMORPHISM_TRACE12_OBSTRUCTION_PASS','dimension':24,'CM_type_stabilizer':[1,29],'nodes':347,'nonzero_closed_ball_vectors':0,'isomorphism_trace_required':12,'scope':'Exact full-lattice finite obstruction; actual geometric/Hodge identification remains the named human-proof input.'})
    def test_independent_full_lattice_and_reverse_ball(self):
        r=subprocess.run([sys.executable,'-B',str(ROOT/'independent/a_unmarked_polarization_v140.py')],capture_output=True,text=True,timeout=25,check=True)
        result=json.loads(r.stdout)
        self.assertEqual(result['status'],'INDEPENDENT_FULL_A_OBSTRUCTION_PASS')
        self.assertEqual(result['constraint_row_lattice_index'],1)
        self.assertEqual(result['nodes'],925)
        self.assertEqual(result['nonzero_closed_trace12_ball_vectors'],0)
    def test_disabled_assertions_rejected(self):
        r=subprocess.run([sys.executable,'-O','-B',str(CERT)],capture_output=True,text=True,timeout=25)
        self.assertNotEqual(r.returncode,0)
        self.assertIn('Enabled assertions are required',r.stderr)
if __name__=='__main__':unittest.main()
